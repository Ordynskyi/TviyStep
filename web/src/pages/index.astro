---
import Layout from "../layouts/Layout.astro";
import { icons, infoBlocks, pageDescription, pageTitle, site } from "../data/site.ts";
---

<Layout title={pageTitle} description={pageDescription} lang="uk">
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&display=swap"
			rel="stylesheet"
		/>
	</Fragment>

	<style>
		@import "../styles/home.css";
	</style>

	<!-- SVG RIBBON GRADIENT DEFINITIONS -->
	<svg width="0" height="0" style="position: absolute;">
		<defs>
			<linearGradient id="ribbonGradient" x1="0%" y1="0%" x2="0%" y2="100%">
				<stop offset="0%" stop-color="#D8C28A" stop-opacity="0.2" />
				<stop offset="25%" stop-color="#D8C28A" stop-opacity="0.9" />
				<stop offset="55%" stop-color="#F4F0E8" stop-opacity="0.8" />
				<stop offset="85%" stop-color="#D8C28A" stop-opacity="0.9" />
				<stop offset="100%" stop-color="#D8C28A" stop-opacity="0.3" />
			</linearGradient>
		</defs>
	</svg>

	<!-- FIXED COSMIC STAR PARTICLES & SUNRISE BACKDROP -->
	<div class="sky-backdrop-fixed" aria-hidden="true">
		<canvas id="starCanvas"></canvas>
		<div class="dawn-overlay" id="dawnOverlay"></div>
	</div>

	<!-- BACKGROUND SELF-DRAWING RIBBON / GPS RUN-TRACK VECTOR -->
	<div class="scroll-ribbon-container" aria-hidden="true">
		<svg class="scroll-ribbon-svg" preserveAspectRatio="none" viewBox="0 0 1000 6500">
			<!-- Organic flowing ribbon path running through the entire length of page -->
			<path
				id="spineRibbon"
				class="ribbon-spine"
				d="M 500,80
				   C 800,450 880,750 720,1100
				   C 560,1450 180,1650 240,2100
				   C 300,2550 820,2750 780,3200
				   C 740,3650 200,3900 280,4400
				   C 360,4900 840,5150 700,5650
				   C 560,6150 500,6350 500,6500"
			/>
			<path
				class="ribbon-accent"
				d="M 520,100
				   C 820,470 900,770 740,1120
				   C 580,1470 200,1670 260,2120
				   C 320,2570 840,2770 800,3220
				   C 760,3670 220,3920 300,4420
				   C 380,4920 860,5170 720,5670
				   C 580,6170 520,6370 520,6500"
			/>
		</svg>
	</div>

	<!-- TOPBAR -->
	<header class="topbar">
		<div class="container nav-wrapper">
			<a href="#top" class="brand" aria-label="Твій STEP на головну">
				<span class="brand-mark">
					<img src="/images/home/logo.svg" alt="Логотип Твій STEP" />
				</span>
				<span class="brand-text">Твій <span>STEP</span></span>
			</a>

			<nav class="nav-menu" aria-label="Головна навігація">
				<a href="#hero" class="nav-link">Головна</a>
				<a href="#chapter-02" class="nav-link">Тренування</a>
				<a href="#chapter-03" class="nav-link">Сенс</a>
				<a href="#chapter-04" class="nav-link">Спільнота</a>
				<a href="#join" class="nav-link">Приєднатися</a>
			</nav>

			<div class="nav-actions">
				<a
					class="social-link"
					href={site.social.instagram}
					target="_blank"
					rel="noreferrer"
					aria-label="Instagram"
				>
					<Fragment set:html={icons.instagram} />
				</a>
				<a
					class="social-link"
					href={site.social.tiktok}
					target="_blank"
					rel="noreferrer"
					aria-label="TikTok"
				>
					<Fragment set:html={icons.tiktok} />
				</a>
				<a
					class="btn-cta-nav"
					href={site.social.telegram}
					target="_blank"
					rel="noreferrer"
				>
					<Fragment set:html={icons.telegram} />
					<span>Чат клубу</span>
				</a>

				<button class="nav-toggle" id="navToggle" type="button" aria-label="Відкрити меню">
					☰
				</button>
			</div>
		</div>

		<div class="mobile-menu-drawer" id="mobileDrawer">
			<div class="container">
				<a href="#hero" class="nav-link">Головна</a>
				<a href="#chapter-02" class="nav-link">Тренування</a>
				<a href="#chapter-03" class="nav-link">Сенс</a>
				<a href="#chapter-04" class="nav-link">Спільнота</a>
				<a href="#join" class="nav-link">Приєднатися</a>
				<a
					class="btn-primary"
					href={site.social.telegram}
					target="_blank"
					rel="noreferrer"
					style="margin-top: 10px;"
				>
					Долучитись у Telegram
				</a>
			</div>
		</div>
	</header>

	<!-- FIXED SLIDE INDICATOR (DESKTOP) - Dynamically generated by JS to match active sections -->
	<nav class="slide-indicator" aria-label="Навігація по слайдах" id="slideIndicator"></nav>

	<main id="top">
		{
			infoBlocks.map((ch, idx) => {
				const isEven = idx % 2 === 1;
				const isHero = idx === 0;
				const isLast = ch.images.length === 0;

				if (isHero) {
					return (
						/* HERO SECTION - Powered by first infoBlock (Logo Constellation) */
						<section id="hero" class="chapter-block reveal" data-slide-title="Головна" data-constellation={JSON.stringify(ch.constellationEffect)}>
							<div class="container">
								<div class="chapter-layout">
									<!-- TEXT COLUMN -->
									<div class="chapter-text-col">
										<div id="heroLogoSlot" class="slide-constellation-slot" aria-hidden="true"></div>

										{ch.texts.map((p, pIdx) => (
											<p class="chapter-desc spawn spawn-text" style={`--spawn-delay: ${pIdx * 120 + 150}ms`} set:html={p} />
										))}

										<div class="hero-actions reveal">
											<a
												class="btn-primary"
												href={site.social.telegram}
												target="_blank"
												rel="noreferrer"
											>
												<Fragment set:html={icons.telegram} />
												<span>Приєднатися</span>
											</a>
											<a class="btn-secondary" href="#chapter-02">
												<span>Дізнатися більше</span>
												<Fragment set:html={icons.arrowRight} />
											</a>
										</div>
									</div>

									<!-- MEDIA COLUMN (AUTO/MANUAL CAROUSEL) -->
									<div class="chapter-media-col spawn spawn-media" style="--spawn-delay: 300ms">
										{ch.images.length > 0 && (
											<div class="media-slider-container" data-slider>
												<div class="slider-track" data-track>
													{ch.images.map((imgSrc, slideIdx) => (
														<figure class="slider-slide">
															<img
																src={imgSrc}
																alt={`Спільнота Твій STEP ${slideIdx + 1}`}
																loading="lazy"
																decoding="async"
															/>
															<div class="slider-overlay-gradient" />
														</figure>
													))}
												</div>

												{ch.images.length > 1 && (
													<div class="slider-controls-bar">
														<div class="slider-dots" data-dots>
															{ch.images.map((_, dotIdx) => (
																<button
																	type="button"
																	class={`slider-dot ${dotIdx === 0 ? "active" : ""}`}
																	data-slide-index={dotIdx}
																	aria-label={`Перейти до слайду ${dotIdx + 1}`}
																/>
															))}
														</div>
														<div class="slider-buttons">
															<button
																type="button"
																class="slider-btn"
																data-action="prev"
																aria-label="Попереднє фото"
															>
																←
															</button>
															<button
																type="button"
																class="slider-btn"
																data-action="next"
																aria-label="Наступне фото"
															>
																→
															</button>
														</div>
													</div>
												)}
											</div>
										)}
									</div>
								</div>
							</div>
						</section>
					);
				}

				if (isLast) {
					return (
						/* FINAL CLIMAX CTA CHAPTER */
						<section id="join" class="chapter-cta-block reveal" data-slide-title="Приєднатися" data-constellation={JSON.stringify(ch.constellationEffect)}>
							<div class="container">
								<div class="cta-box">
									<!-- Final Compass / Sunrise Starlight Constellation Slot -->
									<div
										id={`constellationSlot-${idx}`}
										class="slide-constellation-slot cta-constellation-slot"
										aria-hidden="true"
									></div>

									{ch.texts.map((p, pIdx) => (
										pIdx === ch.texts.length - 1 ? (
											<h2 class="cta-title" set:html={p} />
										) : (
											<p class="cta-lead" set:html={p} />
										)
									))}

									<div class="cta-actions">
										<a
											class="btn-primary"
											href={site.social.telegram}
											target="_blank"
											rel="noreferrer"
											style="padding: 0 36px; height: 56px; font-size: 1.05rem;"
										>
											<Fragment set:html={icons.telegram} />
											<span>Увійти в Telegram-канал</span>
										</a>
										<a
											class="btn-secondary"
											href={site.social.instagram}
											target="_blank"
											rel="noreferrer"
											style="height: 56px;"
										>
											<Fragment set:html={icons.instagram} />
											<span>Instagram спільноти</span>
										</a>
									</div>

									<div class="cta-proof-strip">
										<div class="cta-proof-item">
											<span>✓</span> Вільна участь
										</div>
										<div class="cta-proof-item">
											<span>✓</span> Будь-який рівень підготовки
										</div>
										<div class="cta-proof-item">
											<span>✓</span> Локації по всьому Києву
										</div>
									</div>
								</div>
							</div>
							<div class="steppe-landscape" aria-hidden="true">
								<img src="/images/home/steppe_background.jpeg" alt="" width="1408" height="768" loading="lazy" decoding="async" />
							</div>
						</section>
					);
				}

				return (
					/* STANDARD EDITORIAL CHAPTER */
					<section
						id={`chapter-${ch.num}`}
						class="chapter-block reveal"
						data-slide-title={`Розділ ${ch.num}`}
						data-constellation={JSON.stringify(ch.constellationEffect)}
					>
						<div class="container">
							<div class={`chapter-layout ${isEven ? "reverse" : ""}`}>
								<!-- TEXT COLUMN -->
								<div class="chapter-text-col">
									<!-- Sport Constellation Slot (Calisthenics, Cyclist, Runner) -->
									<div
										id={`constellationSlot-${idx}`}
										class="slide-constellation-slot"
										aria-hidden="true"
									></div>

									{ch.texts.map((p, pIdx) => (
										<p class="chapter-desc spawn spawn-text" style={`--spawn-delay: ${pIdx * 120 + 150}ms`} set:html={p} />
									))}
								</div>

								<!-- MEDIA COLUMN (AUTO/MANUAL CAROUSEL) -->
								<div class="chapter-media-col spawn spawn-media" style="--spawn-delay: 300ms">
									{ch.images.length > 0 && (
										<div class="media-slider-container" data-slider>
											<div class="slider-track" data-track>
												{ch.images.map((imgSrc, slideIdx) => (
													<figure class="slider-slide">
														<img
															src={imgSrc}
															alt={`Кадр спільноти Твій STEP ${slideIdx + 1}`}
															loading="lazy" decoding="async"
														/>
														<div class="slider-overlay-gradient" />
													</figure>
												))}
											</div>

											{ch.images.length > 1 && (
												<div class="slider-controls-bar">
													<div class="slider-dots" data-dots>
														{ch.images.map((_, dotIdx) => (
															<button
																type="button"
																class={`slider-dot ${dotIdx === 0 ? "active" : ""}`}
																data-slide-index={dotIdx}
																aria-label={`Перейти до слайду ${dotIdx + 1}`}
															/>
														))}
													</div>
													<div class="slider-buttons">
														<button
															type="button"
															class="slider-btn"
															data-action="prev"
															aria-label="Попереднє фото"
														>
															←
														</button>
														<button
															type="button"
															class="slider-btn"
															data-action="next"
															aria-label="Наступне фото"
														>
															→
														</button>
													</div>
												</div>
											)}
										</div>
									)}
								</div>
							</div>
						</div>
					</section>
				);
			})
		}
	</main>

	<!-- FOOTER -->
	<footer>
		<div class="container">
			<div class="footer-inner">
				<div class="footer-brand-col">
					<a href="#top" class="brand">
						<span class="brand-mark">
							<img src="/images/home/logo.svg" alt="Логотип Твій STEP" />
						</span>
						<span class="brand-text">Твій <span>STEP</span></span>
					</a>
					<span class="footer-tagline">Твій крок. Твій шлях. Твій степ.</span>
				</div>

				<div class="footer-socials">
					<a
						class="social-link"
						href={site.social.telegram}
						target="_blank"
						rel="noreferrer"
						aria-label="Telegram"
					>
						<Fragment set:html={icons.telegram} />
					</a>
					<a
						class="social-link"
						href={site.social.instagram}
						target="_blank"
						rel="noreferrer"
						aria-label="Instagram"
					>
						<Fragment set:html={icons.instagram} />
					</a>
					<a
						class="social-link"
						href={site.social.tiktok}
						target="_blank"
						rel="noreferrer"
						aria-label="TikTok"
					>
						<Fragment set:html={icons.tiktok} />
					</a>
				</div>
			</div>

			<div class="footer-copy">
				<span>© {new Date().getFullYear()} Твій STEP. Київ, Україна. Всі права захищено.</span>
				<span>Вільний рух • Без абонементів • Місто як майданчик</span>
			</div>
		</div>
	</footer>

	<!-- INTERACTIVE SCRIPT: SCROLL RIBBON, SLIDERS, OBSERVERS -->
	<script>
		import "../scripts/home.ts";
	</script>
</Layout>
