		}

		// 6. Cosmic Star Particles Form Logo & Disperse on Scroll + Sunrise Sky
		// Uses the exact WebGL shader math & diffraction spikes from OpenAI Astra
		const initCosmicField = () => {
			const canvas = document.getElementById("starCanvas") as HTMLCanvasElement | null;
			const dawnOverlay = document.getElementById("dawnOverlay");
			const dawnSunDisc = document.getElementById("dawnSunDisc");

			if (!canvas || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

			// =========================================================================
			// TUNING PARAMETERS FOR LOGO WORDS & AMBIENT STARS
			// =========================================================================
			const STAR_CONFIG = {
				// Word "твій"
				tviy: {
					gap: 2, // sampling step (px)
					alphaThreshold: 20, // 0-255: lower captures thinner letter parts
					sizeMin: 2.0, // base star size min (px)
					sizeMax: 4.2, // base star size max (px)
					brightnessMin: 1.0,
					brightnessMax: 1.6,
					rayStrengthMin: 0.25,
					rayStrengthMax: 0.60,
					featuredRatio: 0.16, // fraction of stars that become cross-spikes
					featuredSizeMin: 2.5,
					featuredSizeMax: 4.0,
					featuredRayMin: 0.80,
					featuredRayMax: 1.10,
					featuredBrightnessMin: 1.6,
					featuredBrightnessMax: 2.2,
					color: { r: 0.88, g: 0.78, b: 0.56 },
				},
				// Word "STEP" (with prominent cross-spike stars)
				step: {
					gapDivider: 115, // offWidth / gapDivider gives sampling step (~3-4px)
					alphaThreshold: 60,
					sizeMin: 2.0,
					sizeMax: 4.2,
					brightnessMin: 1.1,
					brightnessMax: 1.6,
					rayStrengthMin: 0.25,
					rayStrengthMax: 0.60,
					featuredRatio: 0.16, // 16% prominent cross-spikes
					featuredSizeMin: 2.0,
					featuredSizeMax: 9.5,
					featuredRayMin: 0.80,
					featuredRayMax: 1.10,
					featuredBrightnessMin: 1.8,
					featuredBrightnessMax: 2.5,
					colorIvory: { r: 0.96, g: 0.94, b: 0.92 },
					colorGold: { r: 0.88, g: 0.78, b: 0.56 },
				},
				// Ambient sky stars
				ambient: {
					densityDivider: 2600, // screen area (w*h) / divider gives count
					sizeMin: 1.5,
					sizeMax: 3.3,
					brightnessMin: 0.8,
					brightnessMax: 1.2,
					rayStrengthMin: 0.10,
					rayStrengthMax: 0.30,
					featuredRatio: 0.08,
					featuredSizeMin: 5.0,
					featuredSizeMax: 9.0,
					featuredRayMin: 0.65,
					featuredRayMax: 0.90,
				},
			};

			// =========================================================================
			// TUNING PARAMETERS FOR SUNRISE PROGRESSION
			// =========================================================================
			const SUNRISE_CONFIG = {
				// Exponent factor for sunrise curve:
				// 1.0       = strictly linear progression from top (0%) to bottom (100%)
				// 2.0       = quadratic curve (gentle sunrise acceleration)
				// 3.0 - 3.5 = natural dawn (dark night on slide 2, soft morning glow mid-page, full dawn at bottom)
				// 4.0 - 6.0 = steep exponential (stays night until the final climax/footer)
				exponent: 3,

				// Curve algorithm:
				// 'power'       -> p^exponent (standard power law: strictly linear when exponent = 1.0)
				// 'exponential' -> (e^(exponent * p) - 1) / (e^exponent - 1)
				curve: "power" as "power" | "exponential",

				// Maximum opacity of the warm Kyiv sunrise sky gradient reached at page bottom (0.0 - 1.0)
				maxOverlayOpacity: 0.98,

				// Starlight dimming as sunrise brightens:
				// skyFade = max(1.0 - dawnAlpha * starDimmingFactor, minStarOpacity)
				starDimmingFactor: 0.74,
				minStarOpacity: 0.16,

				// Rising sun disc properties
				sunDisc: {
					exponent: 1.25, // secondary exponent for disc emergence
					translateYStart: 85, // starting px offset below horizon
					scaleMin: 0.85,
					scaleMax: 1.2,
				},
			};

			// Helper: evaluate dawn progress from linear (1.0) to exponential (n)
			const calculateDawnAlpha = (p: number, exp: number, curveType: "power" | "exponential" = "power"): number => {
				const clamped = Math.min(Math.max(p, 0), 1);
				if (exp <= 1) return clamped;
				if (curveType === "exponential") {
					return (Math.exp(exp * clamped) - 1) / (Math.exp(exp) - 1);
				}
				return Math.pow(clamped, exp);
			};

			const gl = canvas.getContext("webgl", { alpha: true, antialias: true, premultipliedAlpha: true });
			if (!gl) return;
				const vsSource = `
					attribute vec2 aOrigin;
					attribute vec2 aSpread;
					attribute float aSize;
					attribute vec3 aColor;
					attribute float aBrightness;
					attribute float aTwinklePhase;
					attribute float aRayStrength;
					attribute float aIsLogo;

					uniform vec2 uResolution;
					uniform float uTime;
					uniform float uDispersion;
					uniform float uLogoFade;
					uniform float uSkyFade;
					uniform float uPixelRatio;

					varying float vBrightness;
					varying vec3 vColor;
					varying float vOpacity;
					varying float vRayStrength;
					varying float vParticleDiameter;

					void main() {
						float driftX = sin(uTime * 1.4 + aTwinklePhase) * 2.0;
						float driftY = cos(uTime * 1.1 + aTwinklePhase) * 2.0;
						// Only logo stars disperse and spread outwards; ambient background stars stay in their natural cosmic positions
						vec2 pos = aOrigin + aSpread * (uDispersion * aIsLogo) + vec2(driftX, driftY);

						vec2 zeroToOne = pos / uResolution;
						vec2 clipSpace = (zeroToOne * 2.0 - 1.0) * vec2(1.0, -1.0);
						gl_Position = vec4(clipSpace, 0.0, 1.0);

						float twinkle = 0.72 + 0.28 * sin(uTime * 3.2 + aTwinklePhase);
						// Logo stars smoothly fade out as they disperse (uLogoFade); ambient stars gently react to the sunrise (uSkyFade)
						float starFade = mix(uSkyFade, uLogoFade, aIsLogo);
						vOpacity = twinkle * starFade;
						vBrightness = aBrightness * (0.8 + 0.3 * twinkle);
						vColor = aColor;
						vRayStrength = aRayStrength;

						float diam = aSize * uPixelRatio * (1.0 + uDispersion * 0.15 * aIsLogo);
						gl_PointSize = max(diam, 1.5);
						vParticleDiameter = gl_PointSize;
					}
				`;

				const fsSource = `
					precision mediump float;

					varying float vBrightness;
					varying vec3 vColor;
					varying float vOpacity;
					varying float vRayStrength;
					varying float vParticleDiameter;

					float astraCubicCoverage(float coordinate) {
						float x = abs(coordinate);
						if (x < 1.0) return (4.0 - 6.0 * x * x + 3.0 * x * x * x) / 6.0;
						float tail = max(2.0 - x, 0.0);
						return tail * tail * tail / 6.0;
					}

					float astraFilteredCore(vec2 pixel, float area) {
						return astraCubicCoverage(pixel.x) * astraCubicCoverage(pixel.y)
							* area * vParticleDiameter * vParticleDiameter;
					}

					void main() {
						vec2 pixel = (gl_PointCoord - vec2(0.5)) * max(vParticleDiameter, 4.0);
						vec2 point = pixel * 2.0 / max(vParticleDiameter, 0.0001);
						float distanceToCenter = length(point);
						float disc = 1.0 - smoothstep(0.06, 1.0, distanceToCenter);
						float core = pow(disc, 2.2);

						// Exact OpenAI Astra 4-pointed cross needle diffraction rays:
						float horizontalRay = exp(-abs(point.y) * 28.0) * (1.0 - smoothstep(0.15, 1.0, abs(point.x)));
						float verticalRay = exp(-abs(point.x) * 28.0) * (1.0 - smoothstep(0.15, 1.0, abs(point.y)));
						float rays = max(horizontalRay, verticalRay) * 0.95 * vRayStrength;

						float resolved = smoothstep(2.0, 4.0, vParticleDiameter);
						float alpha = mix(astraFilteredCore(pixel, 0.150904), max(core, rays), resolved) * vOpacity;

						if (alpha <= 0.01) {
							discard;
						}

						float whiteCore = mix(0.59228, core, resolved) * smoothstep(0.7, 2.2, vBrightness) * 0.85;
						float colorEnergy = 1.0 - min(vColor.r, min(vColor.g, vColor.b));
						vec3 emission = mix(vColor, vec3(1.0), whiteCore) * vBrightness * (1.0 + colorEnergy * 0.42);

						gl_FragColor = vec4(emission * alpha, alpha);
					}
				`;

				const createShader = (type: number, src: string) => {
					const shader = gl.createShader(type);
					if (!shader) return null;
					gl.shaderSource(shader, src);
					gl.compileShader(shader);
					if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
						console.error("Shader compile error:", gl.getShaderInfoLog(shader));
						gl.deleteShader(shader);
						return null;
					}
					return shader;
				};

				const vs = createShader(gl.VERTEX_SHADER, vsSource);
				const fs = createShader(gl.FRAGMENT_SHADER, fsSource);
				const program = gl.createProgram();
				if (!vs || !fs || !program) return;

				gl.attachShader(program, vs);
				gl.attachShader(program, fs);
				gl.linkProgram(program);

				if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
					console.error("Program link error:", gl.getProgramInfoLog(program));
					return;
				}

				gl.useProgram(program);

				// Uniform locations
				const uResolutionLoc = gl.getUniformLocation(program, "uResolution");
				const uTimeLoc = gl.getUniformLocation(program, "uTime");
				const uDispersionLoc = gl.getUniformLocation(program, "uDispersion");
				const uLogoFadeLoc = gl.getUniformLocation(program, "uLogoFade");
				const uSkyFadeLoc = gl.getUniformLocation(program, "uSkyFade");
				const uPixelRatioLoc = gl.getUniformLocation(program, "uPixelRatio");

				// Attribute locations
				const aOriginLoc = gl.getAttribLocation(program, "aOrigin");
				const aSpreadLoc = gl.getAttribLocation(program, "aSpread");
				const aSizeLoc = gl.getAttribLocation(program, "aSize");
				const aColorLoc = gl.getAttribLocation(program, "aColor");
				const aBrightnessLoc = gl.getAttribLocation(program, "aBrightness");
				const aTwinklePhaseLoc = gl.getAttribLocation(program, "aTwinklePhase");
				const aRayStrengthLoc = gl.getAttribLocation(program, "aRayStrength");
				const aIsLogoLoc = gl.getAttribLocation(program, "aIsLogo");

				let width = window.innerWidth;
				let height = window.innerHeight;
				let dpr = Math.min(window.devicePixelRatio || 1, 2);

				let particleCount = 0;
				const vbo = gl.createBuffer();

				// Sample authentic logo graphic (drawing full SVG aspect ratio 2199:1431)
				const buildTargetsFromImage = (img: HTMLImageElement | null): { x: number; y: number; isGold: boolean; isFeatured: boolean; isTviy: boolean }[] => {
					const off = document.createElement("canvas");
					const octx = off.getContext("2d", { willReadFrequently: true });
					if (!octx) return [];

					const slot = document.getElementById("heroLogoSlot");
					let startX: number;
					let startY: number;
					let offWidth: number;
					let offHeight: number;

					if (slot) {
						const rect = slot.getBoundingClientRect();
						offWidth = Math.floor(rect.width) || 440;
						offHeight = Math.floor(rect.height) || Math.floor(offWidth * (1431 / 2199));
						startX = rect.left;
						startY = rect.top + window.scrollY;
					} else {
						const maxWidth = Math.min(width * 0.88, 480);
						const ratio = 1431 / 2199;
						offWidth = Math.floor(maxWidth);
						offHeight = Math.floor(maxWidth * ratio);
						startX = (width - offWidth) / 2;
						startY = Math.max(60, (height - offHeight) * 0.38);
					}

					off.width = offWidth;
					off.height = offHeight;

					if (img && (img.naturalWidth > 0 || img.complete)) {
						// Render full authentic SVG logo vector
						octx.drawImage(img, 0, 0, offWidth, offHeight);
						const imgData = octx.getImageData(0, 0, offWidth, offHeight).data;
						const coords: { x: number; y: number; isGold: boolean; isFeatured: boolean; isTviy: boolean }[] = [];

						// Sampling gaps from STAR_CONFIG:
						const stepGap = Math.max(3, Math.floor(offWidth / STAR_CONFIG.step.gapDivider));
						const tviyGap = STAR_CONFIG.tviy.gap;

						// 1. Sample TVIY region with high density:
						// In logo: TVIY is in rows py < offHeight * 0.165, and ends before T at px < offWidth * 0.27
						const tviyMaxY = Math.floor(offHeight * 0.165);
						const tviyMaxX = Math.floor(offWidth * 0.27);

						for (let py = 0; py < tviyMaxY; py += tviyGap) {
							for (let px = 0; px < tviyMaxX; px += tviyGap) {
								const idx = (py * offWidth + px) * 4;
								if (imgData[idx + 3] > STAR_CONFIG.tviy.alphaThreshold) {
									coords.push({
										x: startX + px,
										y: startY + py,
										isGold: false,
										isFeatured: Math.random() < STAR_CONFIG.tviy.featuredRatio,
										isTviy: true,
									});
								}
							}
						}

						// 2. Sample STEP region with standard gap:
						for (let py = 0; py < offHeight; py += stepGap) {
							for (let px = 0; px < offWidth; px += stepGap) {
								const isInsideTviy = py < tviyMaxY && px < tviyMaxX;
								if (!isInsideTviy) {
									const idx = (py * offWidth + px) * 4;
									if (imgData[idx + 3] > STAR_CONFIG.step.alphaThreshold) {
										coords.push({
											x: startX + px,
											y: startY + py,
											isGold: py > offHeight * 0.20,
											isFeatured: Math.random() < STAR_CONFIG.step.featuredRatio,
											isTviy: false,
										});
									}
								}
							}
						}

						if (coords.length > 200) return coords;
					}

					// Geometric fallback precisely matching the logo layout:
					// "твій" sits on top left, fitted under & before the crossbar of T,
					// "STEP" has custom wide T and long descender on P
					octx.fillStyle = "#ffffff";
					octx.textAlign = "left";
					octx.textBaseline = "middle";

					const sSize = offHeight * 0.52;
					octx.font = `800 ${sSize}px "Manrope", sans-serif`;

					// S, T, E, P positions
					const sY = offHeight * 0.55;
					octx.fillText("S", offWidth * 0.05, sY);
					octx.fillText("T", offWidth * 0.30, sY);
					octx.fillText("E", offWidth * 0.52, sY);
					octx.fillText("P", offWidth * 0.76, sY);

					// Long descender tail for letter P
					const pStemX = offWidth * 0.76;
					const pStemW = sSize * 0.14;
					octx.fillRect(pStemX, sY, pStemW, offHeight * 0.42);

					// "твій" small, fitted above S and left of T stem
					const tviySize = sSize * 0.26;
					octx.font = `700 ${tviySize}px "Manrope", sans-serif`;
					octx.fillText("твій", offWidth * 0.05, offHeight * 0.14);

					const imgData = octx.getImageData(0, 0, offWidth, offHeight).data;
					const coords: { x: number; y: number; isGold: boolean; isFeatured: boolean; isTviy: boolean }[] = [];
					const stepGap = Math.max(3, Math.floor(offWidth / STAR_CONFIG.step.gapDivider));
					const tviyGap = STAR_CONFIG.tviy.gap;
					const tviyMaxY = Math.floor(offHeight * 0.165);
					const tviyMaxX = Math.floor(offWidth * 0.27);

					// Sample TVIY in fallback
					for (let py = 0; py < tviyMaxY; py += tviyGap) {
						for (let px = 0; px < tviyMaxX; px += tviyGap) {
							const idx = (py * offWidth + px) * 4;
							if (imgData[idx + 3] > STAR_CONFIG.tviy.alphaThreshold) {
								coords.push({
									x: startX + px,
									y: startY + py,
									isGold: false,
									isFeatured: Math.random() < STAR_CONFIG.tviy.featuredRatio,
									isTviy: true,
								});
							}
						}
					}

					// Sample STEP in fallback
					for (let py = 0; py < offHeight; py += stepGap) {
						for (let px = 0; px < offWidth; px += stepGap) {
							const isInsideTviy = py < tviyMaxY && px < tviyMaxX;
							if (!isInsideTviy) {
								const idx = (py * offWidth + px) * 4;
								if (imgData[idx + 3] > STAR_CONFIG.step.alphaThreshold) {
									coords.push({
										x: startX + px,
										y: startY + py,
										isGold: py > offHeight * 0.20,
										isFeatured: Math.random() < STAR_CONFIG.step.featuredRatio,
										isTviy: false,
									});
								}
							}
						}
					}
					return coords;
				};

				const updateParticleBuffer = (targets: { x: number; y: number; isGold: boolean; isFeatured: boolean; isTviy: boolean }[]) => {
					// Layout per vertex (12 floats):
					// aOrigin: x, y (2)
					// aSpread: sx, sy (2)
					// aSize: size (1)
					// aColor: r, g, b (3)
					// aBrightness: brightness (1)
					// aTwinklePhase: phase (1)
					// aRayStrength: rayStrength (1)
					// aIsLogo: 1.0 (logo) vs 0.0 (ambient) (1)
					// Total = 12 floats per star

					const ambientCount = Math.floor((width * height) / STAR_CONFIG.ambient.densityDivider);
					const totalStars = targets.length + ambientCount;
					particleCount = totalStars;
					const data = new Float32Array(totalStars * 12);

					let offset = 0;

					// 1. Constellation Logo Stars
					targets.forEach((pt) => {
						const angle = Math.random() * Math.PI * 2;
						const dist = Math.random() * Math.max(width, height) * 0.85 + 150;
						const spreadX = Math.cos(angle) * dist;
						const spreadY = Math.sin(angle) * dist - Math.random() * 200;

						let size: number;
						let rayStrength: number;
						let brightness: number;
						let r: number, g: number, b: number;

						if (pt.isTviy) {
							const cfg = STAR_CONFIG.tviy;
							if (pt.isFeatured) {
								size = Math.random() * (cfg.featuredSizeMax - cfg.featuredSizeMin) + cfg.featuredSizeMin;
								rayStrength = Math.random() * (cfg.featuredRayMax - cfg.featuredRayMin) + cfg.featuredRayMin;
								brightness = Math.random() * (cfg.featuredBrightnessMax - cfg.featuredBrightnessMin) + cfg.featuredBrightnessMin;
							} else {
								size = Math.random() * (cfg.sizeMax - cfg.sizeMin) + cfg.sizeMin;
								rayStrength = Math.random() * (cfg.rayStrengthMax - cfg.rayStrengthMin) + cfg.rayStrengthMin;
								brightness = Math.random() * (cfg.brightnessMax - cfg.brightnessMin) + cfg.brightnessMin;
							}
							r = cfg.color.r;
							g = cfg.color.g;
							b = cfg.color.b;
						} else {
							// STEP
							const cfg = STAR_CONFIG.step;
							if (pt.isFeatured) {
								size = Math.random() * (cfg.featuredSizeMax - cfg.featuredSizeMin) + cfg.featuredSizeMin;
								rayStrength = Math.random() * (cfg.featuredRayMax - cfg.featuredRayMin) + cfg.featuredRayMin;
								brightness = Math.random() * (cfg.featuredBrightnessMax - cfg.featuredBrightnessMin) + cfg.featuredBrightnessMin;
							} else {
								size = Math.random() * (cfg.sizeMax - cfg.sizeMin) + cfg.sizeMin;
								rayStrength = Math.random() * (cfg.rayStrengthMax - cfg.rayStrengthMin) + cfg.rayStrengthMin;
								brightness = Math.random() * (cfg.brightnessMax - cfg.brightnessMin) + cfg.brightnessMin;
							}
							const col = pt.isGold ? cfg.colorGold : cfg.colorIvory;
							r = col.r;
							g = col.g;
							b = col.b;
						}

						// aOrigin
						data[offset++] = pt.x;
						data[offset++] = pt.y;
						// aSpread
						data[offset++] = spreadX;
						data[offset++] = spreadY;
						// aSize
						data[offset++] = size;
						// aColor
						data[offset++] = r;
						data[offset++] = g;
						data[offset++] = b;
						// aBrightness
						data[offset++] = brightness;
						// aTwinklePhase
						data[offset++] = Math.random() * Math.PI * 2;
						// aRayStrength
						data[offset++] = rayStrength;
						// aIsLogo: 1.0 indicates logo star (will disperse & smoothly vanish)
						data[offset++] = 1.0;
					});

					// 2. Ambient Deep-Sky Cosmic Stars (stay fixed in place across the night sky)
					for (let i = 0; i < ambientCount; i++) {
						const rx = Math.random() * width;
						const ry = Math.random() * height;
						const isGold = Math.random() > 0.6;
						const amb = STAR_CONFIG.ambient;
						const isFeatured = Math.random() < amb.featuredRatio;

						let size: number;
						let rayStrength: number;
						if (isFeatured) {
							size = Math.random() * (amb.featuredSizeMax - amb.featuredSizeMin) + amb.featuredSizeMin;
							rayStrength = Math.random() * (amb.featuredRayMax - amb.featuredRayMin) + amb.featuredRayMin;
						} else {
							size = Math.random() * (amb.sizeMax - amb.sizeMin) + amb.sizeMin;
							rayStrength = Math.random() * (amb.rayStrengthMax - amb.rayStrengthMin) + amb.rayStrengthMin;
						}
						const brightness = Math.random() * (amb.brightnessMax - amb.brightnessMin) + amb.brightnessMin;

						const r = isGold ? 0.86 : 0.95;
						const g = isGold ? 0.77 : 0.94;
						const b = isGold ? 0.55 : 0.92;

						data[offset++] = rx;
						data[offset++] = ry;
						// aSpread = 0 for ambient stars so dispersion never moves them
						data[offset++] = 0;
						data[offset++] = 0;
						data[offset++] = size;
						data[offset++] = r;
						data[offset++] = g;
						data[offset++] = b;
						data[offset++] = brightness;
						data[offset++] = Math.random() * Math.PI * 2;
						data[offset++] = rayStrength;
						// aIsLogo: 0.0 indicates ambient star (immune to explosion & logo fade)
						data[offset++] = 0.0;
					}

					gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
					gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);

					// Setup vertex attribute pointers
					const stride = 12 * 4; // 12 floats * 4 bytes

					gl.enableVertexAttribArray(aOriginLoc);
					gl.vertexAttribPointer(aOriginLoc, 2, gl.FLOAT, false, stride, 0);

					gl.enableVertexAttribArray(aSpreadLoc);
					gl.vertexAttribPointer(aSpreadLoc, 2, gl.FLOAT, false, stride, 2 * 4);

					gl.enableVertexAttribArray(aSizeLoc);
					gl.vertexAttribPointer(aSizeLoc, 1, gl.FLOAT, false, stride, 4 * 4);

					gl.enableVertexAttribArray(aColorLoc);
					gl.vertexAttribPointer(aColorLoc, 3, gl.FLOAT, false, stride, 5 * 4);

					gl.enableVertexAttribArray(aBrightnessLoc);
					gl.vertexAttribPointer(aBrightnessLoc, 1, gl.FLOAT, false, stride, 8 * 4);

					gl.enableVertexAttribArray(aTwinklePhaseLoc);
					gl.vertexAttribPointer(aTwinklePhaseLoc, 1, gl.FLOAT, false, stride, 9 * 4);

					gl.enableVertexAttribArray(aRayStrengthLoc);
					gl.vertexAttribPointer(aRayStrengthLoc, 1, gl.FLOAT, false, stride, 10 * 4);

					gl.enableVertexAttribArray(aIsLogoLoc);
					gl.vertexAttribPointer(aIsLogoLoc, 1, gl.FLOAT, false, stride, 11 * 4);
				};

				const resize = () => {
					width = window.innerWidth;
					height = window.innerHeight;
					dpr = Math.min(window.devicePixelRatio || 1, 2);

					canvas.width = width * dpr;
					canvas.height = height * dpr;
					gl.viewport(0, 0, canvas.width, canvas.height);

					gl.useProgram(program);
					gl.uniform2f(uResolutionLoc, width, height);
					gl.uniform1f(uPixelRatioLoc, dpr);

					updateParticleBuffer(buildTargetsFromImage(logoImage));
				};

				// Initial buffer with typographic fallback
				let logoImage: HTMLImageElement | null = null;
				resize();

				// Load SVG logo
				const loadedLogo = new Image();
				loadedLogo.src = "/images/home/logo.svg";
				loadedLogo.onload = () => {
					logoImage = loadedLogo;
					const exactTargets = buildTargetsFromImage(loadedLogo);
					if (exactTargets.length > 200) {
						updateParticleBuffer(exactTargets);
					}
				};

				window.addEventListener("resize", resize, { passive: true });

				// Scroll states: hero exit controls logo dispersion, while sunrise is exponential across the full page
				let logoProgress = 0;
				let dawnAlpha = 0;
				let cachedSkyMaxScroll = 1;

				const updateSkyMaxScroll = () => {
					cachedSkyMaxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
				};
				updateSkyMaxScroll();
				window.addEventListener("resize", updateSkyMaxScroll, { passive: true });

				const updateSkyOnScroll = () => {
					const scrollY = window.scrollY;

					// 1. Logo dispersion: logo typography stars disperse as user scrolls away from the hero section
					const heroRange = Math.max(window.innerHeight * 0.95, 600);
					logoProgress = Math.min(Math.max(scrollY / heroRange, 0), 1);

					// 2. Sunrise progression: spans the entire page using SUNRISE_CONFIG (1 = linear, n = exponential)
					const pageProgress = Math.min(Math.max(scrollY / cachedSkyMaxScroll, 0), 1);

					dawnAlpha = calculateDawnAlpha(pageProgress, SUNRISE_CONFIG.exponent, SUNRISE_CONFIG.curve);

					if (dawnOverlay) {
						dawnOverlay.style.opacity = `${dawnAlpha * SUNRISE_CONFIG.maxOverlayOpacity}`;
					}
					if (dawnSunDisc) {
						const discOpacity = Math.pow(dawnAlpha, SUNRISE_CONFIG.sunDisc.exponent);
						const discTranslateY = (1 - dawnAlpha) * SUNRISE_CONFIG.sunDisc.translateYStart;
						const discScale =
							SUNRISE_CONFIG.sunDisc.scaleMin +
							dawnAlpha * (SUNRISE_CONFIG.sunDisc.scaleMax - SUNRISE_CONFIG.sunDisc.scaleMin);
						dawnSunDisc.style.opacity = `${discOpacity}`;
						dawnSunDisc.style.transform = `translateX(-50%) translateY(${discTranslateY}px) scale(${discScale}) translateZ(0)`;
					}
				};

				updateSkyOnScroll();

				// WebGL Blend Mode for additive starlight
				gl.enable(gl.BLEND);
				gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

				let time = 0;
				const render = () => {
					time += 0.022;

					// Synchronize sky atmosphere smoothly with each render frame (0 forced layout reflows)
					updateSkyOnScroll();

					// Cubic hermite dispersion for logo stars
					const p = logoProgress;
					const dispersion = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;

					// Logo stars smoothly disappear as they spread away from the hero (complete fade by p = 1.0)
					const logoFade = Math.pow(Math.max(1.0 - p, 0.0), 1.5);

					// Starlight softly dims as the golden sunrise reaches its peak at the bottom
					const skyFade = Math.max(
						1.0 - dawnAlpha * SUNRISE_CONFIG.starDimmingFactor,
						SUNRISE_CONFIG.minStarOpacity
					);

					gl.clearColor(0, 0, 0, 0);
					gl.clear(gl.COLOR_BUFFER_BIT);

					gl.useProgram(program);
					gl.uniform1f(uTimeLoc, time);
					gl.uniform1f(uDispersionLoc, dispersion);
					gl.uniform1f(uLogoFadeLoc, logoFade);
					gl.uniform1f(uSkyFadeLoc, skyFade);

					gl.drawArrays(gl.POINTS, 0, particleCount);

					requestAnimationFrame(render);
				};

				render();
		};

		initCosmicField();
	</script>
</Layout>
