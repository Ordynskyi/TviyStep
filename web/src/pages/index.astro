  {
    q: "Чи можна прийти, якщо я новачок?",
    a: "Так. Спільнота відкрита для всіх рівнів. Тут підтримують перший крок, а не оцінюють темп."
  },
  {
    q: "Чи є зараз фіксований графік?",
    a: "Ні, зараз немає стабільного розкладу. Домовленості відбуваються в Telegram."
  },
  {
    q: "Скільки коштує участь?",
    a: "Участь у спільноті безкоштовна."
  },
  {
    q: "Що важливо перед першим кроком?",
    a: "Зручний одяг, вода і готовність знайомитися. Усе інше формується в процесі."
  }
];

const icons = {
  telegram: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>`,
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>`,
  tiktok: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>`
};

const pageTitle = `${site.brand} - ${site.title}`;
const pageDescription = "Твій STEP - відкрита спільнота руху. Рух у своєму темпі, атмосфера підтримки, люди та горизонт.";
---

<Layout title={pageTitle} description={pageDescription} lang="uk">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
  </Fragment>

  <style>
      :root {
        --bg: #f3efe7;
        --ink: #17181d;
        --muted: rgba(23, 24, 29, 0.72);
        --sand: #d0b57a;
        --line: rgba(23, 24, 29, 0.14);
        --panel: rgba(255, 255, 255, 0.52);
        --panel-strong: rgba(255, 255, 255, 0.72);
        --hero-ink: #111218;
        --font-body: "Manrope", "Segoe UI", sans-serif;
        --font-display: "Playfair Display", "Times New Roman", serif;
        --space-section: clamp(38px, 4.2vw, 54px);
        --space-section-tight: clamp(30px, 4vw, 46px);
        --topbar-height: 74px;
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        color: var(--ink);
        line-height: 1.6;
        font-family: var(--font-body);
        background:
          radial-gradient(circle at 12% 10%, rgba(208, 181, 122, 0.24), transparent 34%),
          radial-gradient(circle at 85% 7%, rgba(23, 24, 29, 0.11), transparent 31%),
          linear-gradient(110deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0) 34%),
          var(--bg);
        animation: page-fade 540ms ease-out;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(1140px, calc(100% - 32px));
        margin: 0 auto;
      }

      section[id] {
        scroll-margin-top: calc(var(--topbar-height) + 16px);
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(243, 239, 231, 0.78);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .nav {
        min-height: 74px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0;
      }

      .brand-mark {
        width: 64px;
        height: 64px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .brand-mark img {
        width: 64px;
        height: 64px;
        display: block;
        object-fit: contain;
      }

      .nav-links,
      .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .nav-toggle {
        display: none;
      }

      .nav-links {
        gap: 24px;
        color: var(--muted);
        font-size: 0.92rem;
      }

      .nav-links a {
        position: relative;
        padding-bottom: 3px;
      }

      .nav-links a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 1px;
        background: rgba(23, 24, 29, 0.46);
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 220ms ease;
      }

      .nav-links a:hover::after {
        transform: scaleX(1);
      }

      .button {
        min-height: 46px;
        padding: 0 20px;
        border-radius: 999px;
        border: 1px solid var(--ink);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s ease;
        font-weight: 600;
        letter-spacing: 0.01em;
      }

      .button:hover { transform: translateY(-1px); }

      .button.primary {
        color: #f8f4ea;
        background: var(--hero-ink);
        border-color: var(--hero-ink);
      }

      .button.secondary {
        background: rgba(255, 255, 255, 0.5);
      }

      .button.icon-btn {
        padding: 0;
        width: 44px;
        min-height: 44px;
        border: none;
        background: transparent !important;
        color: var(--ink);
      }

      main section {
        padding: var(--space-section) 0;
      }

      .hero {
        padding-top: var(--space-section-tight);
        padding-bottom: clamp(32px, 4.5vw, 56px);
      }

      .hero > .container > div:first-child {
        animation: rise-in 760ms 80ms both cubic-bezier(0.2, 0.65, 0.2, 1);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: clamp(22px, 3vw, 34px);
        align-items: start;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 16px;
        font-size: 0.76rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(23, 24, 29, 0.64);
        font-weight: 700;
        border-bottom: 1px solid rgba(23, 24, 29, 0.24);
        padding-bottom: 3px;
      }

      h1 {
        margin: 0 0 16px;
        font-family: var(--font-display);
        font-size: clamp(2.1rem, 5.8vw, 4.8rem);
        line-height: 0.97;
        letter-spacing: -0.015em;
        color: var(--hero-ink);
        text-wrap: balance;
      }

      .title-line {
        display: block;
      }

      .lead-copy {
        margin: 0 0 18px;
        max-width: 60ch;
      }

      .lead {
        margin: 0 0 10px;
        color: var(--muted);
        font-size: 1rem;
        max-width: 56ch;
      }

      .lead:last-child {
        margin-bottom: 0;
      }

      .hero-actions {
        margin-bottom: 10px;
      }

      .hero-more {
        margin-top: 8px;
      }

      .hero-more details {
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 8px 12px;
        background: rgba(255, 255, 255, 0.46);
      }

      .hero-more summary {
        cursor: pointer;
        font-weight: 600;
        font-size: 0.94rem;
      }

      .hero-more p {
        margin: 10px 0 0;
      }

      .proof-strip {
        margin-top: 16px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
      }

      .proof-chip {
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 9px 11px;
        background: rgba(255, 255, 255, 0.56);
        display: grid;
        gap: 2px;
      }

      .proof-chip .k {
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(23, 24, 29, 0.62);
      }

      .proof-chip .v {
        font-size: 0.94rem;
        font-weight: 600;
      }

      .hero-visual {
        border: 1px solid var(--line);
        border-radius: 36px;
        padding: 0;
        background: transparent;
        display: block;
        min-height: 0;
        box-shadow: 0 28px 52px rgba(23, 24, 29, 0.18);
        overflow: hidden;
        position: relative;
        animation: rise-in 820ms 180ms both cubic-bezier(0.2, 0.65, 0.2, 1);
      }

      .hero-visual::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(170deg, rgba(255, 255, 255, 0) 35%, rgba(23, 24, 29, 0.24) 100%);
        pointer-events: none;
      }

      .hero-visual img {
        width: 100%;
        height: auto;
        min-height: 0;
        display: block;
        object-fit: contain;
        border: 0;
        border-radius: 0;
      }

      .hero-visual video {
        width: 100%;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        aspect-ratio: 16 / 9;
        object-fit: cover;
      }



      .photo-card {
        display: grid;
        gap: 10px;
      }

      .photo-card img {
        width: 100%;
        border-radius: 16px;
        border: 1px solid var(--line);
      }

      .photo-caption {
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.55;
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 16px;
      }


      .section-head h2 {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(1.9rem, 3.9vw, 3.1rem);
        letter-spacing: -0.02em;
        line-height: 1;
        text-wrap: balance;
      }

      .section-head p {
        margin: 0;
        color: var(--muted);
        max-width: 620px;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .card {
        border: 1px solid var(--line);
        background: var(--panel-strong);
        border-radius: 22px;
        padding: 22px 20px;
        transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
      }

      .card:hover {
        transform: translateY(-4px);
        border-color: rgba(23, 24, 29, 0.3);
        background: rgba(255, 255, 255, 0.86);
        box-shadow: 0 16px 30px rgba(23, 24, 29, 0.09);
      }

      .card h3 {
        margin: 0 0 8px;
        font-size: 1.2rem;
        letter-spacing: -0.02em;
        font-family: var(--font-display);
      }

      .card p {
        margin: 0;
        color: var(--muted);
      }

      .label {
        display: inline-block;
        margin-bottom: 10px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(208, 181, 122, 0.7);
        background: rgba(208, 181, 122, 0.2);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .band .container {
        padding: clamp(14px, 2.2vw, 24px);
        border-radius: 28px;
        border: 1px solid var(--line);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0.4));
      }

      .faq details {
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 12px 14px;
        background: var(--panel-strong);
      }

      .faq details + details {
        margin-top: 10px;
      }

      .faq summary {
        cursor: pointer;
        font-weight: 600;
      }

      .faq p {
        margin: 10px 0 0;
      }

      .team-note {
        border: 1px dashed rgba(23, 24, 29, 0.26);
        border-radius: 18px;
        padding: 14px;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 640ms cubic-bezier(0.2, 0.65, 0.2, 1), transform 640ms cubic-bezier(0.2, 0.65, 0.2, 1);
      }

      .reveal.in-view {
        opacity: 1;
        transform: translateY(0);
      }

      .stagger > * {
        transition-delay: 0ms;
      }

      .stagger.in-view > :nth-child(1) { transition-delay: 40ms; }
      .stagger.in-view > :nth-child(2) { transition-delay: 140ms; }
      .stagger.in-view > :nth-child(3) { transition-delay: 240ms; }
      .stagger.in-view > :nth-child(4) { transition-delay: 340ms; }

      @keyframes page-fade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes rise-in {
        from {
          opacity: 0;
          transform: translateY(26px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes drift {
        from { transform: translate3d(-1.8%, 0, 0); }
        to { transform: translate3d(2.2%, -2.2%, 0); }
      }




      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation: none !important;
          transition: none !important;
          scroll-behavior: auto !important;
        }

        .reveal {
          opacity: 1;
          transform: none;
        }
      }

      footer {
        border-top: 1px solid var(--line);
        padding: 22px 0 38px;
      }

      .join-band {
        margin-top: 6px;
      }

      .join-band .container {
        border: 1px solid rgba(23, 24, 29, 0.22);
        border-radius: 24px;
        background: linear-gradient(120deg, rgba(17, 18, 24, 0.95), rgba(36, 38, 49, 0.94));
        color: #f8f4ea;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
      }

      .join-band h3 {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(1.3rem, 2.6vw, 1.9rem);
      }

      .join-band p {
        margin: 4px 0 0;
        color: rgba(248, 244, 234, 0.85);
      }

      .join-band .button.primary {
        background: #f8f4ea;
        color: #17181d;
        border-color: #f8f4ea;
      }

      .mobile-drawer {
        display: none;
      }

      .footer-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        color: var(--muted);
      }

      .social-icon {
        color: var(--ink);
        transition: transform 0.2s ease;
        display: flex;
      }

      .social-icon:hover {
        transform: scale(1.1);
      }

      @media (max-width: 980px) {
        .hero-grid,
        .grid-3,
        .grid-2 {
          grid-template-columns: 1fr;
        }

        .hero-visual {
          min-height: 0;
          aspect-ratio: auto;
        }

        .hero-visual img {
          min-height: 0;
          height: auto;
          object-fit: contain;
          object-position: 54% 50%;
        }

        .eyebrow {
          margin-bottom: 10px;
          font-size: 0.7rem;
        }

        h1 {
          margin-bottom: 12px;
          font-size: clamp(2rem, 12vw, 3.1rem);
          line-height: 1.02;
        }

        .lead {
          font-size: 1rem;
          margin-bottom: 16px;
        }

        .hero-actions {
          margin-bottom: 8px;
          gap: 10px;
          flex-wrap: wrap;
        }

        .section-head {
          display: block;
        }

        .section-head p {
          margin-top: 10px;
        }

        .nav-links {
          display: none;
        }

        .nav-toggle {
          display: inline-flex;
          min-height: 42px;
          padding: 0 14px;
          border: 1px solid var(--line);
          border-radius: 999px;
          background: rgba(255, 255, 255, 0.56);
          font-weight: 600;
          font-family: var(--font-body);
        }

        .nav-actions {
          gap: 6px;
        }

        .proof-strip {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
        }

        .mobile-drawer {
          display: block;
          max-height: 0;
          overflow: hidden;
          opacity: 0;
          border-top: 1px solid transparent;
          transition: max-height 260ms ease, opacity 220ms ease, border-color 220ms ease;
        }

        .mobile-drawer.open {
          max-height: 360px;
          opacity: 1;
          border-color: var(--line);
        }

        .mobile-drawer .container {
          display: grid;
          gap: 8px;
          padding: 12px 0 14px;
        }

        .mobile-drawer a {
          padding: 10px 12px;
          border-radius: 10px;
          background: rgba(255, 255, 255, 0.48);
        }

        .join-band .container {
          padding: 16px;
        }

        .band .container {
          padding: 14px;
        }
      }
    </style>

