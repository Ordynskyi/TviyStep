	<!-- INTERACTIVE SCRIPT: SCROLL RIBBON, SLIDERS, OBSERVERS -->
	<script>
		// 1. Mobile Menu Toggle
		const navToggle = document.getElementById("navToggle");
		const mobileDrawer = document.getElementById("mobileDrawer");
		if (navToggle && mobileDrawer) {
			navToggle.addEventListener("click", () => {
				mobileDrawer.classList.toggle("open");
			});
			mobileDrawer.querySelectorAll("a").forEach((l) => {
				l.addEventListener("click", () => mobileDrawer.classList.remove("open"));
			});
		}

		// 2. Self-Drawing Scroll Ribbon (Spine vector tied to scroll progress)
		const ribbon = document.getElementById("spineRibbon") as SVGGeometryElement | null;
		if (ribbon && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			try {
				const length = ribbon.getTotalLength();
				ribbon.style.strokeDasharray = `${length} ${length}`;
				ribbon.style.strokeDashoffset = `${length}`;

				let cachedMaxScroll = 0;
				const measureMaxScroll = () => {
					cachedMaxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
				};
				measureMaxScroll();
				window.addEventListener("resize", measureMaxScroll, { passive: true });

				let ticking = false;
				const updateRibbon = () => {
					const scrollY = window.scrollY;
					if (cachedMaxScroll > 0) {
						const progress = Math.min(Math.max(scrollY / cachedMaxScroll, 0), 1);
						// Draw ribbon slightly ahead of viewport for dramatic anticipation
						const drawLength = length * Math.min(progress * 1.08, 1);
						ribbon.style.strokeDashoffset = `${length - drawLength}`;
					}
					ticking = false;
				};

				window.addEventListener("scroll", () => {
					if (!ticking) {
						window.requestAnimationFrame(updateRibbon);
						ticking = true;
					}
				}, { passive: true });

				updateRibbon();
			} catch (e) {
				console.debug("Ribbon calculation init", e);
			}
		}

		// 3. Chapter Carousels with Auto-scroll and Manual controls
		const sliders = document.querySelectorAll<HTMLElement>("[data-slider]");
		sliders.forEach((slider) => {
			const track = slider.querySelector<HTMLElement>("[data-track]");
			const dots = Array.from(slider.querySelectorAll<HTMLButtonElement>(".slider-dot"));
			const prevBtn = slider.querySelector<HTMLButtonElement>('[data-action="prev"]');
			const nextBtn = slider.querySelector<HTMLButtonElement>('[data-action="next"]');
			if (!track) return;

			let currentIndex = 0;
			const slidesCount = track.children.length;
			let timer: ReturnType<typeof setInterval> | null = null;

			const updateDots = (idx: number) => {
				dots.forEach((dot, dIdx) => {
					dot.classList.toggle("active", dIdx === idx);
				});
			};

			const goToSlide = (idx: number) => {
				if (idx < 0) idx = slidesCount - 1;
				if (idx >= slidesCount) idx = 0;
				currentIndex = idx;
				track.scrollTo({
					left: track.clientWidth * idx,
					behavior: "smooth"
				});
				updateDots(idx);
			};

			// Prev / Next actions
			if (prevBtn) {
				prevBtn.addEventListener("click", () => {
					stopAuto();
					goToSlide(currentIndex - 1);
					startAuto();
				});
			}
			if (nextBtn) {
				nextBtn.addEventListener("click", () => {
					stopAuto();
					goToSlide(currentIndex + 1);
					startAuto();
				});
			}

			// Dot click
			dots.forEach((dot) => {
				dot.addEventListener("click", () => {
					stopAuto();
					const targetIndex = Number(dot.dataset.slideIndex || 0);
					goToSlide(targetIndex);
					startAuto();
				});
			});

			// Auto rotation
			const startAuto = () => {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				if (slidesCount <= 1) return;
				if (timer) clearInterval(timer);
				timer = setInterval(() => {
					goToSlide(currentIndex + 1);
				}, 4200);
			};

			const stopAuto = () => {
				if (timer) clearInterval(timer);
				timer = null;
			};

			slider.addEventListener("mouseenter", stopAuto);
			slider.addEventListener("mouseleave", startAuto);
			startAuto();

			// Sync dot on native touch swipe
			track.addEventListener("scroll", () => {
				const activeSlide = Math.round(track.scrollLeft / track.clientWidth);
				if (activeSlide !== currentIndex && activeSlide >= 0 && activeSlide < slidesCount) {
					currentIndex = activeSlide;
					updateDots(currentIndex);
				}
			}, { passive: true });
		});

		// 4. Reveal on Scroll (Intersection Observer)
		const reveals = document.querySelectorAll(".reveal");
		if (
			!window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
			"IntersectionObserver" in window
		) {
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("in-view");
						}
					});
				},
				{ threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
			);

			reveals.forEach((el) => observer.observe(el));
		} else {
			reveals.forEach((el) => el.classList.add("in-view"));
		}

		// 5. Desktop Floating Slide Indicator & Snapping Navigation
		const slideIndicator = document.getElementById("slideIndicator");

		// =========================================================================
		// TUNING PARAMETERS FOR SLIDE TRANSITIONS & WHEEL SNAPPING SPEED
		// =========================================================================
		const SLIDE_TRANSITION_CONFIG = {
			// Duration of animated transition between slides in milliseconds
			// 400ms = snappy / quick
			// 750ms = balanced cinematic
			// 1000ms - 2500ms = slow, calm & immersive
			durationMs: 1000,

			// Easing function for smooth slide transition:
			// 'easeInOutCubic', 'easeOutExpo', 'easeInOutQuad', or 'linear'
			easing: "easeInOutQuad" as "easeInOutCubic" | "easeOutExpo" | "easeInOutQuad" | "linear",

			// Enable smooth wheel hijacking between full-height slides
			// When true, scrolling the mouse wheel triggers an animated slide jump with durationMs
			enableWheelSnap: true,
		};

		// Easing calculators
		const easeFunctions = {
			easeInOutCubic: (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2),
			easeOutExpo: (t: number) => (t === 1 ? 1 : 1 - Math.pow(2, -10 * t)),
			easeInOutQuad: (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2),
			linear: (t: number) => t,
		};

		let isSlideTransitioning = false;
		let slideAnimationId: number | null = null;
		let wheelCooldownTimer: ReturnType<typeof setTimeout> | null = null;
		let wheelBlocked = false;

		// Global Slide Offsets for Snap Navigation & Starlight Interpolation
		let cachedSlideOffsets: { id: string; top: number }[] = [];
		let cachedDocHeight = 0;

		const getSlideOffsets = () => {
			if (cachedSlideOffsets.length > 0) return cachedSlideOffsets;
			const sections = Array.from(document.querySelectorAll<HTMLElement>("main > section[id]"));
			const scrollY = window.scrollY;
			cachedDocHeight = document.documentElement.scrollHeight;
			const maxScrollY = Math.max(cachedDocHeight - window.innerHeight, 0);

			const raw = sections.map((el) => {
				const rect = el.getBoundingClientRect();
				return { id: el.id, top: Math.min(Math.max(0, Math.round(rect.top + scrollY)), maxScrollY) };
			});

			if (raw.length > 0 && maxScrollY > raw[raw.length - 1].top + 20) {
				raw.push({ id: "footer", top: maxScrollY });
			}

			const clean: typeof raw = [];
			for (let i = 0; i < raw.length; i++) {
				if (i === 0 || raw[i].top > clean[clean.length - 1].top + 15) {
					clean.push(raw[i]);
				}
			}
			cachedSlideOffsets = clean;
			return cachedSlideOffsets;
		};

		const refreshSlideOffsets = () => {
			cachedSlideOffsets = [];
			getSlideOffsets();
		};
		window.addEventListener("resize", refreshSlideOffsets, { passive: true });

		const smoothScrollToTarget = (targetY: number, onComplete?: () => void) => {
			if (slideAnimationId !== null) {
				cancelAnimationFrame(slideAnimationId);
				slideAnimationId = null;
			}
			if (wheelCooldownTimer) {
				clearTimeout(wheelCooldownTimer);
				wheelCooldownTimer = null;
			}

			// Ensure native browser CSS scroll-behavior and scroll-snap do not interfere with frame-by-frame updates
			document.documentElement.style.scrollBehavior = "auto";
			document.documentElement.style.scrollSnapType = "none";

			const maxScrollY = Math.max(document.documentElement.scrollHeight - window.innerHeight, 0);
			const clampedTargetY = Math.min(Math.max(0, Math.round(targetY)), maxScrollY);

			const startY = window.scrollY;
			const distance = clampedTargetY - startY;
			if (Math.abs(distance) < 2) {
				isSlideTransitioning = false;
				wheelBlocked = false;
				if (onComplete) onComplete();
				return;
			}

			isSlideTransitioning = true;
			wheelBlocked = true;
			const startTime = performance.now();
			const duration = SLIDE_TRANSITION_CONFIG.durationMs;
			const ease = easeFunctions[SLIDE_TRANSITION_CONFIG.easing] || easeFunctions.easeInOutCubic;

			const step = (now: number) => {
				const elapsed = now - startTime;
				const progress = Math.min(elapsed / duration, 1);
				const eased = ease(progress);

				window.scrollTo(0, startY + distance * eased);

				if (progress < 1) {
					slideAnimationId = requestAnimationFrame(step);
				} else {
					window.scrollTo(0, clampedTargetY);
					isSlideTransitioning = false;
					slideAnimationId = null;

					if (wheelCooldownTimer) clearTimeout(wheelCooldownTimer);
					wheelCooldownTimer = setTimeout(() => {
						wheelBlocked = false;
					}, 200);

					if (onComplete) onComplete();
				}
			};

			slideAnimationId = requestAnimationFrame(step);
		};

		if (slideIndicator) {
			// Automatically discover all slide sections on the page with an ID
			const slideSections = Array.from(
				document.querySelectorAll<HTMLElement>("main > section[id]")
			);

			// Dynamically populate indicator dots
			slideIndicator.innerHTML = "";
			const slideTargets: { dot: HTMLButtonElement; id: string; el: HTMLElement }[] = [];

			slideSections.forEach((sec, idx) => {
				const id = sec.id;
				const title = sec.dataset.slideTitle || sec.querySelector("h1, h2, .chapter-index")?.textContent?.trim() || `Слайд ${idx + 1}`;
				const dot = document.createElement("button");
				dot.type = "button";
				dot.className = `slide-dot ${idx === 0 ? "active" : ""}`;
				dot.dataset.slideTarget = id;
				dot.setAttribute("aria-label", `${title}`);

				const tooltip = document.createElement("span");
				tooltip.className = "slide-dot-tooltip";
				tooltip.textContent = title;
				dot.appendChild(tooltip);

				slideIndicator.appendChild(dot);
				slideTargets.push({ dot, id, el: sec });
			});

			const slideDots = slideTargets.map((item) => item.dot);
			let activeIndex = 0;

			slideTargets.forEach(({ dot }, idx) => {
				dot.addEventListener("click", () => {
					activeIndex = idx;
					const offsets = getSlideOffsets();
					const targetY = offsets[idx]?.top ?? 0;
					smoothScrollToTarget(targetY);
				});
			});

			// Smooth transitions for in-page anchor links (e.g. hero CTA, navbar links)
			document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
				link.addEventListener("click", (e) => {
					const href = link.getAttribute("href");
					if (!href || href === "#") return;
					const targetId = href.slice(1);
					const targetEl = targetId === "top" ? document.body : document.getElementById(targetId);
					if (targetEl) {
						e.preventDefault();
						const targetY = targetEl.getBoundingClientRect().top + window.scrollY;
						smoothScrollToTarget(targetY);
					}
				});
			});

			// Intercept wheel on desktop for configurable transition speed between slides
			if (
				SLIDE_TRANSITION_CONFIG.enableWheelSnap &&
				window.innerWidth > 960 &&
				!window.matchMedia("(prefers-reduced-motion: reduce)").matches
			) {
				window.addEventListener(
					"wheel",
					(e) => {
						// Don't intercept if modifier keys pressed
						if (e.ctrlKey || e.metaKey || e.altKey) return;

						// Block wheel while transition is active or during trackpad momentum cooldown
						if (isSlideTransitioning || wheelBlocked) {
							e.preventDefault();
							return;
						}

						const delta = e.deltaY;
						if (Math.abs(delta) < 25) return; // ignore micro-jitter

						const offsets = getSlideOffsets();
						const currentScroll = Math.round(window.scrollY);

						let targetTop: number | null = null;

						if (delta > 0) {
							// Scrolling DOWN -> find next slide target below current scroll
							for (let i = 0; i < offsets.length; i++) {
								if (offsets[i].top > currentScroll + 15) {
									targetTop = offsets[i].top;
									break;
								}
							}
						} else if (delta < 0) {
							// Scrolling UP -> find previous slide target above current scroll
							for (let i = offsets.length - 1; i >= 0; i--) {
								if (offsets[i].top < currentScroll - 15) {
									targetTop = offsets[i].top;
									break;
								}
							}
						}

						if (targetTop !== null) {
							e.preventDefault();
							smoothScrollToTarget(targetTop);
						}
					},
					{ passive: false }
				);
			}

			let activeSlideTicking = false;
			const updateActiveSlide = () => {
				const scrollY = window.scrollY;
				const winH = window.innerHeight;
				const docH = cachedDocHeight || document.documentElement.scrollHeight;
				const isAtBottom = scrollY + winH >= docH - 30;

				let currentTargetId = slideTargets[0]?.id;
				if (isAtBottom && slideTargets.length > 0) {
					currentTargetId = slideTargets[slideTargets.length - 1].id;
				} else {
					const dotIds = new Set(slideTargets.map((item) => item.id));
					const offsets = getSlideOffsets().filter((o) => dotIds.has(o.id));
					const middle = scrollY + winH * 0.45;
					let closestDist = Infinity;

					for (let i = 0; i < offsets.length; i++) {
						const dist = Math.abs(offsets[i].top - middle);
						if (dist < closestDist) {
							closestDist = dist;
							currentTargetId = offsets[i].id;
						}
					}
				}

				slideDots.forEach((dot, idx) => {
					const isActive = dot.dataset.slideTarget === currentTargetId;
					dot.classList.toggle("active", isActive);
					if (isActive) activeIndex = idx;
				});
				activeSlideTicking = false;
			};

			window.addEventListener("scroll", () => {
				if (!activeSlideTicking) {
					window.requestAnimationFrame(updateActiveSlide);
					activeSlideTicking = true;
				}
			}, { passive: true });
			updateActiveSlide();
		}

		// 6. Cosmic Star Particles Form Logo & Disperse on Scroll + Sunrise Sky
		// Uses the exact WebGL shader math & diffraction spikes from OpenAI Astra
		const initCosmicField = () => {
			const canvas = document.getElementById("starCanvas") as HTMLCanvasElement | null;
			const dawnOverlay = document.getElementById("dawnOverlay");
			const dawnSunDisc = document.getElementById("dawnSunDisc");

			if (!canvas || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

			// =========================================================================
			// GLOBAL STARLIGHT & SUNRISE SETTINGS
			// Defaults inherited from top-level STAR_CONFIG (with fallback defaults)
			// =========================================================================
			const backdropEl = document.querySelector<HTMLElement>(".sky-backdrop-fixed");
			let parsedGlobalStarConfig: any = null;
			if (backdropEl?.dataset.starConfig) {
				try {
					parsedGlobalStarConfig = JSON.parse(backdropEl.dataset.starConfig);
				} catch (e) {
					console.error("Failed to parse star config", e);
				}
			}

			const AMBIENT_CONFIG = parsedGlobalStarConfig?.ambient ?? {
				densityDivider: 2600,
				sizeMin: 1.5,
				sizeMax: 3.3,
				brightnessMin: 0.8,
				brightnessMax: 1.2,
				rayStrengthMin: 0.10,
				rayStrengthMax: 0.30,
				featuredRatio: 0.08,
				featuredSizeMin: 5.0,
				featuredSizeMax: 9.0,
				featuredRayMin: 0.65,
				featuredRayMax: 0.90,
			};

			const DEFAULT_CONSTELLATION = parsedGlobalStarConfig?.defaultConstellation ?? {
				alphaThreshold: 35,
				gap: 3,
				featuredRatio: 0.16,
				sizeMin: 2.0,
				sizeMax: 4.2,
				brightnessMin: 1.1,
				brightnessMax: 1.6,
				rayStrengthMin: 0.25,
				rayStrengthMax: 0.60,
				featuredSizeMin: 2.5,
				featuredSizeMax: 8.5,
				featuredRayMin: 0.80,
				featuredRayMax: 1.10,
				featuredBrightnessMin: 1.8,
				featuredBrightnessMax: 2.5,
				colorIvory: { r: 0.96, g: 0.94, b: 0.92 },
				colorGold: { r: 0.88, g: 0.78, b: 0.56 },
			};

			// =========================================================================
			// TUNING PARAMETERS FOR SUNRISE PROGRESSION
			// =========================================================================
			const SUNRISE_CONFIG = {
				// Exponent factor for sunrise curve:
				// 1.0       = strictly linear progression from top (0%) to bottom (100%)
				// 2.0       = quadratic curve (gentle sunrise acceleration)
				// 3.0 - 3.5 = natural dawn (dark night on slide 2, soft morning glow mid-page, full dawn at bottom)
				// 4.0 - 6.0 = steep exponential (stays night until the final climax/footer)
				exponent: 3,

				// Curve algorithm:
				// 'power'       -> p^exponent (standard power law: strictly linear when exponent = 1.0)
				// 'exponential' -> (e^(exponent * p) - 1) / (e^exponent - 1)
				curve: "power" as "power" | "exponential",

				// Maximum opacity of the warm Kyiv sunrise sky gradient reached at page bottom (0.0 - 1.0)
				maxOverlayOpacity: 0.98,

				// Starlight dimming as sunrise brightens:
				// skyFade = max(1.0 - dawnAlpha * starDimmingFactor, minStarOpacity)
				starDimmingFactor: 0.74,
				minStarOpacity: 0.16,

				// Rising sun disc properties
				sunDisc: {
					exponent: 1.25, // secondary exponent for disc emergence
					translateYStart: 85, // starting px offset below horizon
					scaleMin: 0.85,
					scaleMax: 1.2,
				},
			};

			// Helper: evaluate dawn progress from linear (1.0) to exponential (n)
			const calculateDawnAlpha = (p: number, exp: number, curveType: "power" | "exponential" = "power"): number => {
				const clamped = Math.min(Math.max(p, 0), 1);
				if (exp <= 1) return clamped;
				if (curveType === "exponential") {
					return (Math.exp(exp * clamped) - 1) / (Math.exp(exp) - 1);
				}
				return Math.pow(clamped, exp);
			};

			const gl = canvas.getContext("webgl", { alpha: true, antialias: true, premultipliedAlpha: true });
			if (!gl) return;
				// Slides are the hero logo slot plus one slot per chapter, all read from the DOM
				const slideIds = ["heroLogoSlot"];
				for (let k = 1; document.getElementById(`constellationSlot-${k}`); k++) {
					slideIds.push(`constellationSlot-${k}`);
				}
				const REAL_SLIDE_COUNT = slideIds.length;
				// Shader slot 0 is the virtual slide -1; real slide k is slot k + 1
				const VIRTUAL_SLOT = 0;
				const slotOf = (realIndex: number) => realIndex + 1;
				const HERO_SLOT = slotOf(0);
				const SLIDE_COUNT = REAL_SLIDE_COUNT + 1;
				const SLIDE_FLOATS = 5; // pos.xy, size, ray, bright
				const SPREAD_IDX = SLIDE_COUNT * SLIDE_FLOATS;
				const ISLOGO_IDX = SPREAD_IDX + 2;
				const COLOR_IDX = SPREAD_IDX + 3;
				const TWINKLE_IDX = SPREAD_IDX + 6;
				const FLOATS_PER_STAR = TWINKLE_IDX + 1;
				const VEC4_COUNT = Math.ceil(FLOATS_PER_STAR / 4);
				const STRIDE_BYTES = VEC4_COUNT * 16;

				if (VEC4_COUNT > gl.getParameter(gl.MAX_VERTEX_ATTRIBS)) {
					console.error("Too many slides for the vertex attribute limit:", SLIDE_COUNT);
					return;
				}

				// Packed float e lives in attribute aD[e / 4], component e % 4
				const floatRef = (e: number) => `aD${e >> 2}.${"xyzw"[e & 3]}`;

				// Emits an if/else chain over the segments between consecutive slides
				const segmentChain = (assign: (s: number) => string) => {
					const last = SLIDE_COUNT - 2;
					const branches: string[] = [];
					for (let s = 0; s < last; s++) {
						branches.push(`if (slideIdx < ${s + 0.5}) { ${assign(s)} }`);
					}
					branches.push(`{ ${assign(last)} }`);
					return branches.join(" else ");
				};

				const buildVertexShader = () => {
					const attributeDecls = Array.from({ length: VEC4_COUNT }, (_, i) => `attribute vec4 aD${i};`).join("\n");
					const uniformDecls = Array.from({ length: SLIDE_COUNT }, (_, k) => `uniform float uSlideTop${k};`).join("\n");
					const slideReads = Array.from({ length: SLIDE_COUNT }, (_, k) => {
						const b = k * SLIDE_FLOATS;
						return `vec2 pos${k} = vec2(${floatRef(b)}, ${floatRef(b + 1)});
						float size${k} = ${floatRef(b + 2)};
						float ray${k} = ${floatRef(b + 3)};
						float bright${k} = ${floatRef(b + 4)};`;
					}).join("\n");

					return `
					${attributeDecls}

					uniform vec2 uResolution;
					uniform float uTime;
					uniform float uSlideProgress;
					uniform float uSkyFade;
					uniform float uPixelRatio;
					uniform float uScrollY;
					${uniformDecls}
					uniform float uRubberStiffness;

					varying float vBrightness;
					varying vec3 vColor;
					varying float vOpacity;
					varying float vRayStrength;
					varying float vParticleDiameter;

					void main() {
						float sp = clamp(uSlideProgress, 0.0, ${SLIDE_COUNT - 1}.0);
						// Last slide must resolve to the final segment with t = 1, not t = 0 of a new segment
						float slideIdx = min(floor(sp), ${SLIDE_COUNT - 2}.0);
						float t = sp - slideIdx;

						${slideReads}
						vec2 spread = vec2(${floatRef(SPREAD_IDX)}, ${floatRef(SPREAD_IDX + 1)});
						float isLogo = ${floatRef(ISLOGO_IDX)};
						vec3 starColor = vec3(${floatRef(COLOR_IDX)}, ${floatRef(COLOR_IDX + 1)}, ${floatRef(COLOR_IDX + 2)});
						float twinklePhase = ${floatRef(TWINKLE_IDX)};

						// Per-star order: stars leave and arrive in a staggered wave, so the group reads as a stream
						float rank = fract(twinklePhase * 0.15915494);
						vec2 destPos;
						float destTop;
						${segmentChain((s) => `destPos = pos${s + 1}; destTop = uSlideTop${s + 1};`)}
						float viewCenterRel = uScrollY + uResolution.y * 0.5 - destTop;
						float rubberDist = isLogo * clamp(abs(viewCenterRel - destPos.y) / (uResolution.y * 0.5), 0.0, 1.0);
						// Stars whose target sits far from the view center (relative to the target slide) fly faster
						float flow = clamp((t - rank * 0.35) * (1.0 + uRubberStiffness * rubberDist) / 0.65, 0.0, 1.0);
						float morphT = smoothstep(0.0, 1.0, flow);

						// Stream envelope: zero at both slides, peaks mid-flight
						float dispersion = sin(flow * 3.14159265);

						vec2 targetPos;
						float targetSize;
						float targetRay;
						float targetBright;
						float targetTop;
						${segmentChain((s) => `targetPos = mix(pos${s}, pos${s + 1}, morphT); targetSize = mix(size${s}, size${s + 1}, morphT); targetRay = mix(ray${s}, ray${s + 1}, morphT); targetBright = mix(bright${s}, bright${s + 1}, morphT); targetTop = mix(uSlideTop${s}, uSlideTop${s + 1}, morphT);`)}

						float driftX = sin(uTime * 1.4 + twinklePhase) * 2.0;
						float driftY = cos(uTime * 1.1 + twinklePhase) * 2.0;

						vec2 travel;
						${segmentChain((s) => `travel = pos${s + 1} - pos${s};`)}
						float travelLen = length(travel);
						vec2 streamNormal = travelLen > 0.001 ? vec2(-travel.y, travel.x) / travelLen : vec2(0.0);

						// Sideways sway: neighbours share a phase, so the stream bends as one body
						float sway = sin(flow * 9.42477796 + (pos0.x + pos0.y) * 0.006 + rank * 0.8 + uTime * 1.2);
						float streamWidth = min(uResolution.x, uResolution.y) * 0.07;
						vec2 streamOffset = streamNormal * sway * dispersion * streamWidth * isLogo;

						float docOffsetY = isLogo * (targetTop - uScrollY);
						vec2 pos = targetPos + vec2(0.0, docOffsetY) + streamOffset + spread * (dispersion * isLogo * 0.12) + vec2(driftX, driftY);

						vec2 zeroToOne = pos / uResolution;
						vec2 clipSpace = (zeroToOne * 2.0 - 1.0) * vec2(1.0, -1.0);
						gl_Position = vec4(clipSpace, 0.0, 1.0);

						float twinkle = 0.72 + 0.28 * sin(uTime * 3.2 + twinklePhase);
						// Fades stars that shrink below the 1.5px minimum point size
						float visibility = clamp(targetSize / 1.5, 0.0, 1.0);
						vOpacity = twinkle * uSkyFade * visibility;
						vBrightness = targetBright * (0.8 + 0.3 * twinkle);
						vColor = starColor;
						vRayStrength = targetRay;

						float diam = targetSize * uPixelRatio * (1.0 + dispersion * 0.25 * isLogo);
						gl_PointSize = targetSize > 0.0 ? max(diam, 1.5) : 0.0;
						vParticleDiameter = gl_PointSize;
					}
				`;
				};

				const vsSource = buildVertexShader();

				const fsSource = `
					precision mediump float;

					varying float vBrightness;
					varying vec3 vColor;
					varying float vOpacity;
					varying float vRayStrength;
					varying float vParticleDiameter;

					float astraCubicCoverage(float coordinate) {
						float x = abs(coordinate);
						if (x < 1.0) return (4.0 - 6.0 * x * x + 3.0 * x * x * x) / 6.0;
						float tail = max(2.0 - x, 0.0);
						return tail * tail * tail / 6.0;
					}

					float astraFilteredCore(vec2 pixel, float area) {
						return astraCubicCoverage(pixel.x) * astraCubicCoverage(pixel.y)
							* area * vParticleDiameter * vParticleDiameter;
					}

					void main() {
						vec2 pixel = (gl_PointCoord - vec2(0.5)) * max(vParticleDiameter, 4.0);
						vec2 point = pixel * 2.0 / max(vParticleDiameter, 0.0001);
						float distanceToCenter = length(point);
						float disc = 1.0 - smoothstep(0.06, 1.0, distanceToCenter);
						float core = pow(disc, 2.2);

						// Exact OpenAI Astra 4-pointed cross needle diffraction rays:
						float horizontalRay = exp(-abs(point.y) * 28.0) * (1.0 - smoothstep(0.15, 1.0, abs(point.x)));
						float verticalRay = exp(-abs(point.x) * 28.0) * (1.0 - smoothstep(0.15, 1.0, abs(point.y)));
						float rays = max(horizontalRay, verticalRay) * 0.95 * vRayStrength;

						float resolved = smoothstep(2.0, 4.0, vParticleDiameter);
						float alpha = mix(astraFilteredCore(pixel, 0.150904), max(core, rays), resolved) * vOpacity;

						if (alpha <= 0.01) {
							discard;
						}

						float whiteCore = mix(0.59228, core, resolved) * smoothstep(0.7, 2.2, vBrightness) * 0.85;
						float colorEnergy = 1.0 - min(vColor.r, min(vColor.g, vColor.b));
						vec3 emission = mix(vColor, vec3(1.0), whiteCore) * vBrightness * (1.0 + colorEnergy * 0.42);

						gl_FragColor = vec4(emission * alpha, alpha);
					}
				`;

				const createShader = (type: number, src: string) => {
					const shader = gl.createShader(type);
					if (!shader) return null;
					gl.shaderSource(shader, src);
					gl.compileShader(shader);
					if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
						console.error("Shader compile error:", gl.getShaderInfoLog(shader));
						gl.deleteShader(shader);
						return null;
					}
					return shader;
				};

				const vs = createShader(gl.VERTEX_SHADER, vsSource);
				const fs = createShader(gl.FRAGMENT_SHADER, fsSource);
				const program = gl.createProgram();
				if (!vs || !fs || !program) return;

				gl.attachShader(program, vs);
				gl.attachShader(program, fs);
				gl.linkProgram(program);

				if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
					console.error("Program link error:", gl.getProgramInfoLog(program));
					return;
				}

				gl.useProgram(program);

				// Uniform locations
				const uResolutionLoc = gl.getUniformLocation(program, "uResolution");
				const uTimeLoc = gl.getUniformLocation(program, "uTime");
				const uSlideProgressLoc = gl.getUniformLocation(program, "uSlideProgress");
				const uSkyFadeLoc = gl.getUniformLocation(program, "uSkyFade");
				const uPixelRatioLoc = gl.getUniformLocation(program, "uPixelRatio");
				const uScrollYLoc = gl.getUniformLocation(program, "uScrollY");
				const uSlideTopLocs = Array.from({ length: SLIDE_COUNT }, (_, k) => gl.getUniformLocation(program, `uSlideTop${k}`));
				const uRubberLoc = gl.getUniformLocation(program, "uRubberStiffness");

				// Attribute locations: VEC4_COUNT packed vec4 attributes per vertex
				const aDLocs = Array.from({ length: VEC4_COUNT }, (_, i) => gl.getAttribLocation(program, `aD${i}`));

				let width = window.innerWidth;
				let height = window.innerHeight;
				let dpr = Math.min(window.devicePixelRatio || 1, 2);

				let particleCount = 0;
				const vbo = gl.createBuffer();

				interface ConstellationSettings {
					size?: number;
					alphaThreshold?: number;
					gap?: number;
					featuredRatio?: number;
					sizeMin?: number;
					sizeMax?: number;
					featuredSizeMin?: number;
					featuredSizeMax?: number;
					brightnessMin?: number;
					brightnessMax?: number;
					featuredBrightnessMin?: number;
					featuredBrightnessMax?: number;
					rayStrengthMin?: number;
					rayStrengthMax?: number;
					featuredRayMin?: number;
					featuredRayMax?: number;
					color?: { r: number; g: number; b: number };
					pivot?: "left" | "center" | "right";
				}

				interface ConstellationConfig {
					svg: string;
					settings?: ConstellationSettings;
				}

				// Sample authentic logo graphic (Slide 0)
				const buildTargetsFromLogo = (
					img: HTMLImageElement | null,
					settings?: ConstellationSettings
				): { x: number; y: number; isGold: boolean; isFeatured: boolean; isTviy: boolean }[] => {
					const off = document.createElement("canvas");
					const octx = off.getContext("2d", { willReadFrequently: true });
					if (!octx) return [];

					const slot = document.getElementById("heroLogoSlot");
					const targetWidth = settings?.size ?? 440;
					let offWidth = targetWidth;
					let offHeight = Math.floor(targetWidth * (1431 / 2199));

					if (slot && settings?.size) {
						slot.style.width = `${settings.size}px`;
					}

					const pivot = settings?.pivot ?? "left";
					let startX = Math.round(width * 0.08);
					let startY = Math.round(height * 0.22);

					if (slot) {
						const textCol = slot.closest(".chapter-text-col, .hero-grid > div") || slot.parentElement || slot;
						const colRect = textCol.getBoundingClientRect();
						const slotRect = slot.getBoundingClientRect();
						const slide = slot.closest("section");
						const slideTop = slide ? slide.getBoundingClientRect().top : 0;
						offWidth = Math.max(Math.floor(slotRect.width), 100);
						offHeight = Math.max(Math.floor(slotRect.height), Math.floor(offWidth * (1431 / 2199)));

						if (pivot === "center") {
							startX = Math.round(colRect.left + (colRect.width - offWidth) / 2);
							slot.style.marginLeft = "auto";
							slot.style.marginRight = "auto";
						} else if (pivot === "right") {
							startX = Math.round(colRect.left + colRect.width - offWidth);
							slot.style.marginLeft = "auto";
							slot.style.marginRight = "0";
						} else { // "left"
							startX = Math.round(colRect.left);
							slot.style.marginLeft = "0";
							slot.style.marginRight = "auto";
						}

						// Y-axis always centered in the slot
						startY = Math.round(slotRect.top - slideTop + (slotRect.height - offHeight) / 2);
					} else {
						if (pivot === "center") {
							startX = Math.round((width - offWidth) / 2);
						} else if (pivot === "right") {
							startX = Math.round(width * 0.92 - offWidth);
						} else {
							startX = Math.round(width * 0.08);
						}
						startY = Math.round((height - offHeight) / 2);
					}

					off.width = offWidth;
					off.height = offHeight;

					const alphaThreshold = settings?.alphaThreshold ?? DEFAULT_CONSTELLATION.alphaThreshold;
					const featRatio = settings?.featuredRatio ?? DEFAULT_CONSTELLATION.featuredRatio;
					const gap = settings?.gap ?? DEFAULT_CONSTELLATION.gap;

					if (img && (img.naturalWidth > 0 || img.complete)) {
						octx.drawImage(img, 0, 0, offWidth, offHeight);
						const imgData = octx.getImageData(0, 0, offWidth, offHeight).data;
						const coords: { x: number; y: number; isGold: boolean; isFeatured: boolean; isTviy: boolean }[] = [];

						const stepGap = Math.max(3, gap);
						const tviyGap = Math.max(2, gap - 1);
						const tviyMaxY = Math.floor(offHeight * 0.165);
						const tviyMaxX = Math.floor(offWidth * 0.27);

						// 1. TVIY region
						for (let py = 0; py < tviyMaxY; py += tviyGap) {
							for (let px = 0; px < tviyMaxX; px += tviyGap) {
								const idx = (py * offWidth + px) * 4;
								if (imgData[idx + 3] > alphaThreshold) {
									coords.push({
										x: startX + px,
										y: startY + py,
										isGold: false,
										isFeatured: Math.random() < featRatio,
										isTviy: true,
									});
								}
							}
						}

						// 2. STEP region
						for (let py = 0; py < offHeight; py += stepGap) {
							for (let px = 0; px < offWidth; px += stepGap) {
								const isInsideTviy = py < tviyMaxY && px < tviyMaxX;
								if (!isInsideTviy) {
									const idx = (py * offWidth + px) * 4;
									if (imgData[idx + 3] > alphaThreshold) {
										coords.push({
											x: startX + px,
											y: startY + py,
											isGold: py > offHeight * 0.20,
											isFeatured: Math.random() < featRatio,
											isTviy: false,
										});
									}
								}
							}
						}

						if (coords.length > 200) return coords;
					}

					// Fallback
					octx.fillStyle = "#ffffff";
					octx.textAlign = "left";
					octx.textBaseline = "middle";

					const sSize = offHeight * 0.52;
					octx.font = `800 ${sSize}px "Manrope", sans-serif`;

					const sY = offHeight * 0.55;
					octx.fillText("S", offWidth * 0.05, sY);
					octx.fillText("T", offWidth * 0.30, sY);
					octx.fillText("E", offWidth * 0.52, sY);
					octx.fillText("P", offWidth * 0.76, sY);

					const pStemX = offWidth * 0.76;
					const pStemW = sSize * 0.14;
					octx.fillRect(pStemX, sY, pStemW, offHeight * 0.42);

					const tviySize = sSize * 0.26;
					octx.font = `700 ${tviySize}px "Manrope", sans-serif`;
					octx.fillText("твій", offWidth * 0.05, offHeight * 0.14);

					const imgData = octx.getImageData(0, 0, offWidth, offHeight).data;
					const coords: { x: number; y: number; isGold: boolean; isFeatured: boolean; isTviy: boolean }[] = [];
					const stepGap = Math.max(3, gap);
					const tviyGap = Math.max(2, gap - 1);
					const tviyMaxY = Math.floor(offHeight * 0.165);
					const tviyMaxX = Math.floor(offWidth * 0.27);

					for (let py = 0; py < tviyMaxY; py += tviyGap) {
						for (let px = 0; px < tviyMaxX; px += tviyGap) {
							const idx = (py * offWidth + px) * 4;
							if (imgData[idx + 3] > alphaThreshold) {
								coords.push({
									x: startX + px,
									y: startY + py,
									isGold: false,
									isFeatured: Math.random() < featRatio,
									isTviy: true,
								});
							}
						}
					}

					for (let py = 0; py < offHeight; py += stepGap) {
						for (let px = 0; px < offWidth; px += stepGap) {
							const isInsideTviy = py < tviyMaxY && px < tviyMaxX;
							if (!isInsideTviy) {
								const idx = (py * offWidth + px) * 4;
								if (imgData[idx + 3] > alphaThreshold) {
									coords.push({
										x: startX + px,
										y: startY + py,
										isGold: py > offHeight * 0.20,
										isFeatured: Math.random() < featRatio,
										isTviy: false,
									});
								}
							}
						}
					}
					return coords;
				};

				// Sample coordinate points for sport silhouette figures
				const sampleShapePoints = (
					img: HTMLImageElement | null,
					slotEl: HTMLElement | null,
					count: number,
					defaultX: number,
					defaultY: number,
					defaultSize: number,
					settings?: ConstellationSettings
				): { x: number; y: number; isFeatured: boolean }[] => {
					const targetSize = settings?.size ?? defaultSize;
					let offW = targetSize;
					let offH = targetSize;
					const threshold = settings?.alphaThreshold ?? DEFAULT_CONSTELLATION.alphaThreshold;
					const stepGap = Math.max(1, Math.round(settings?.gap ?? DEFAULT_CONSTELLATION.gap));
					const featRatio = settings?.featuredRatio ?? DEFAULT_CONSTELLATION.featuredRatio;

					if (slotEl && settings?.size) {
						slotEl.style.width = `${settings.size}px`;
						slotEl.style.height = `${settings.size}px`;
					}

					const pivot = settings?.pivot ?? "center";
					let startX: number;
					let startY: number;

					if (slotEl) {
						const textCol = slotEl.closest(".chapter-text-col, .hero-grid > div, .cta-box") || slotEl.parentElement || slotEl;
						const colRect = textCol.getBoundingClientRect();
						const slotRect = slotEl.getBoundingClientRect();
						const slide = slotEl.closest("section");
						const slideTop = slide ? slide.getBoundingClientRect().top : 0;

						if (pivot === "left") {
							startX = Math.round(colRect.left);
							slotEl.style.marginLeft = "0";
							slotEl.style.marginRight = "auto";
						} else if (pivot === "right") {
							startX = Math.round(colRect.left + colRect.width - offW);
							slotEl.style.marginLeft = "auto";
							slotEl.style.marginRight = "0";
						} else { // "center"
							startX = Math.round(colRect.left + (colRect.width - offW) / 2);
							slotEl.style.marginLeft = "auto";
							slotEl.style.marginRight = "auto";
						}

						// Y-axis always centered in the slot
						startY = Math.round(slotRect.top - slideTop + (slotRect.height - offH) / 2);
					} else {
						if (pivot === "left") {
							startX = Math.round(width * 0.08);
						} else if (pivot === "right") {
							startX = Math.round(width * 0.92 - offW);
						} else {
							startX = Math.round((width - offW) / 2);
						}
						startY = Math.round((height - offH) / 2);
					}

					const off = document.createElement("canvas");
					off.width = offW;
					off.height = offH;
					const ctx = off.getContext("2d", { willReadFrequently: true });
					if (!ctx) return [];

					if (img && (img.naturalWidth > 0 || img.complete)) {
						ctx.drawImage(img, 0, 0, offW, offH);
					} else {
						ctx.fillStyle = "#ffffff";
						ctx.beginPath();
						ctx.arc(offW / 2, offH / 2, offW * 0.38, 0, Math.PI * 2);
						ctx.fill();
					}

					const data = ctx.getImageData(0, 0, offW, offH).data;
					const candidates: { x: number; y: number }[] = [];

					for (let py = 0; py < offH; py += stepGap) {
						for (let px = 0; px < offW; px += stepGap) {
							const alpha = data[(py * offW + px) * 4 + 3];
							if (alpha > threshold) {
								candidates.push({ x: startX + px, y: startY + py });
							}
						}
					}

					if (candidates.length === 0) {
						for (let i = 0; i < count; i++) {
							candidates.push({
								x: startX + offW * 0.5 + (Math.random() - 0.5) * offW * 0.4,
								y: startY + offH * 0.5 + (Math.random() - 0.5) * offH * 0.4,
							});
						}
					}

					// Uniformly sample across candidate points according to stepGap
					const result: { x: number; y: number; isFeatured: boolean }[] = [];
					const numCandidates = candidates.length;
					for (let i = 0; i < count; i++) {
						const candidateIdx = numCandidates > 0 ? (i * 37) % numCandidates : 0;
						const p = candidates[candidateIdx] || { x: startX + offW * 0.5, y: startY + offH * 0.5 };
						const jx = (Math.random() - 0.5) * 1.5;
						const jy = (Math.random() - 0.5) * 1.5;
						result.push({
							x: p.x + jx,
							y: p.y + jy,
							isFeatured: Math.random() < featRatio,
						});
					}
					return result;
				};

				const getStarStyleForSlide = (
					k: number,
					isFeatured: boolean,
					configs?: (ConstellationConfig | null)[]
				) => {
					const s = configs?.[k]?.settings;
					const def = DEFAULT_CONSTELLATION;

					const sMin = s?.sizeMin ?? def.sizeMin;
					const sMax = s?.sizeMax ?? def.sizeMax;
					const featSMin = s?.featuredSizeMin ?? (s?.sizeMin !== undefined ? Math.max(s.sizeMin * 1.5, s.sizeMin + 1) : def.featuredSizeMin);
					const featSMax = s?.featuredSizeMax ?? (s?.sizeMax !== undefined ? Math.max(s.sizeMax * 1.5, s.sizeMax + 2) : def.featuredSizeMax);

					const rMin = s?.rayStrengthMin ?? def.rayStrengthMin;
					const rMax = s?.rayStrengthMax ?? def.rayStrengthMax;
					const featRMin = s?.featuredRayMin ?? def.featuredRayMin;
					const featRMax = s?.featuredRayMax ?? def.featuredRayMax;

					const bMin = s?.brightnessMin ?? def.brightnessMin;
					const bMax = s?.brightnessMax ?? def.brightnessMax;
					const featBMin = s?.featuredBrightnessMin ?? def.featuredBrightnessMin;
					const featBMax = s?.featuredBrightnessMax ?? def.featuredBrightnessMax;

					let size: number;
					let ray: number;
					let bright: number;

					if (isFeatured) {
						const sLo = Math.min(featSMin, featSMax);
						const sHi = Math.max(featSMin, featSMax);
						size = Math.random() * (sHi - sLo) + sLo;

						const rLo = Math.min(featRMin, featRMax);
						const rHi = Math.max(featRMin, featRMax);
						ray = Math.random() * (rHi - rLo) + rLo;

						const bLo = Math.min(featBMin, featBMax);
						const bHi = Math.max(featBMin, featBMax);
						bright = Math.random() * (bHi - bLo) + bLo;
					} else {
						const sLo = Math.min(sMin, sMax);
						const sHi = Math.max(sMin, sMax);
						size = Math.random() * (sHi - sLo) + sLo;

						const rLo = Math.min(rMin, rMax);
						const rHi = Math.max(rMin, rMax);
						ray = Math.random() * (rHi - rLo) + rLo;

						const bLo = Math.min(bMin, bMax);
						const bHi = Math.max(bMin, bMax);
						bright = Math.random() * (bHi - bLo) + bLo;
					}

					return { size, ray, bright };
				};

				type SlidePoint = { x: number; y: number; isGold?: boolean; isFeatured?: boolean };

				// Update particle buffer: one packed record per star, slide data in order
				const updateParticleBuffer = (slotTargets: (SlidePoint[] | null)[], configs?: (ConstellationConfig | null)[]) => {
					const t0 = slotTargets[0] ?? [];
					const ambientCount = Math.floor((width * height) / AMBIENT_CONFIG.densityDivider);
					const constellationCount = t0.length;
					const totalStars = constellationCount + ambientCount;
					particleCount = totalStars;

					const floatsPerVertex = VEC4_COUNT * 4;
					const data = new Float32Array(totalStars * floatsPerVertex);
					let offset = 0;
					const put = (value: number) => {
						data[offset++] = value;
					};
					// Padding floats after the record stay zero
					const endRecord = () => {
						offset += floatsPerVertex - FLOATS_PER_STAR;
					};

					// 1. Morphing Constellation Stars
					const hiddenStyle = { size: 0, ray: 0, bright: 0 };
					for (let i = 0; i < constellationCount; i++) {
						// A slide without points for this star keeps the previous slide's position
						const pts: SlidePoint[] = [];
						for (let k = 0; k < SLIDE_COUNT; k++) {
							pts.push(slotTargets[k]?.[i] ?? pts[k - 1]);
						}
						const styles = pts.map((pt, k) =>
							slotTargets[k] ? getStarStyleForSlide(k, !!pt.isFeatured, configs) : hiddenStyle
						);

						const angle = Math.random() * Math.PI * 2;
						const dist = Math.random() * Math.max(width, height) * 0.75 + 180;
						const spreadX = Math.cos(angle) * dist;
						const spreadY = Math.sin(angle) * dist - Math.random() * 150;

						const customCol = configs?.[0]?.settings?.color;
						const col = customCol ?? (pts[0].isGold ? DEFAULT_CONSTELLATION.colorGold : DEFAULT_CONSTELLATION.colorIvory);
						const twinklePhase = Math.random() * Math.PI * 2;

						pts.forEach((pt, k) => {
							put(pt.x);
							put(pt.y);
							put(styles[k].size);
							put(styles[k].ray);
							put(styles[k].bright);
						});
						put(spreadX);
						put(spreadY);
						put(1.0);
						put(col.r);
						put(col.g);
						put(col.b);
						put(twinklePhase);
						endRecord();
					}

					// 2. Ambient Fixed Cosmic Stars (same position on every slide)
					for (let i = 0; i < ambientCount; i++) {
						const rx = Math.random() * width;
						const ry = Math.random() * height;
						const isGold = Math.random() > 0.6;
						const amb = AMBIENT_CONFIG;
						const isFeatured = Math.random() < amb.featuredRatio;

						let size: number;
						let rayStrength: number;
						if (isFeatured) {
							size = Math.random() * (amb.featuredSizeMax - amb.featuredSizeMin) + amb.featuredSizeMin;
							rayStrength = Math.random() * (amb.featuredRayMax - amb.featuredRayMin) + amb.featuredRayMin;
						} else {
							size = Math.random() * (amb.sizeMax - amb.sizeMin) + amb.sizeMin;
							rayStrength = Math.random() * (amb.rayStrengthMax - amb.rayStrengthMin) + amb.rayStrengthMin;
						}
						const brightness = Math.random() * (amb.brightnessMax - amb.brightnessMin) + amb.brightnessMin;

						const r = isGold ? 0.86 : 0.95;
						const g = isGold ? 0.77 : 0.94;
						const b = isGold ? 0.55 : 0.92;
						const twinklePhase = Math.random() * Math.PI * 2;

						for (let k = 0; k < SLIDE_COUNT; k++) {
							put(rx);
							put(ry);
							put(size);
							put(rayStrength);
							put(brightness);
						}
						put(0.0); // spread x
						put(0.0); // spread y
						put(0.0); // isLogo
						put(r);
						put(g);
						put(b);
						put(twinklePhase);
						endRecord();
					}

					gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
					gl.bufferData(gl.ARRAY_BUFFER, data, gl.STATIC_DRAW);

					aDLocs.forEach((loc, i) => {
						if (loc < 0) return;
						gl.enableVertexAttribArray(loc);
						gl.vertexAttribPointer(loc, 4, gl.FLOAT, false, STRIDE_BYTES, i * 16);
					});
				};

				// Loaded SVG images for each slide constellation
				let loadedImages: (HTMLImageElement | null)[] = [];

				const getConstellationConfigs = (): (ConstellationConfig | null)[] => {
					const sections = Array.from(document.querySelectorAll<HTMLElement>("main > section[id]"));
					const found = sections.map((sec): ConstellationConfig | null => {
						if (sec.dataset.constellation) {
							try {
								return JSON.parse(sec.dataset.constellation) as ConstellationConfig;
							} catch (e) {
								console.error("Failed to parse constellation data", e);
							}
						}
						return sec.dataset.constellationSvg ? { svg: sec.dataset.constellationSvg } : null;
					});
					if (found.length > 0) return found;
					return [
						{ svg: "/images/home/logo.svg", settings: { size: 440, featuredRatio: 0.16 } },
						{ svg: "/images/home/calisthenics.svg", settings: { size: 160, alphaThreshold: 35 } },
						{ svg: "/images/home/cyclist.svg", settings: { size: 190, alphaThreshold: 20 } },
						{ svg: "/images/home/runner.svg", settings: { size: 160, alphaThreshold: 35 } },
						{ svg: "/images/home/compass.svg", settings: { size: 140, alphaThreshold: 35 } },
					];
				};

				const setSlideTops = () => {
					gl.useProgram(program);
					const tops = slideIds.map((id) => {
						const section = document.getElementById(id)?.closest("section");
						return section ? section.getBoundingClientRect().top + window.scrollY : 0;
					});
					// Virtual slide -1 sits one viewport above the hero
					gl.uniform1f(uSlideTopLocs[VIRTUAL_SLOT], tops[0] - height);
					tops.forEach((top, k) => gl.uniform1f(uSlideTopLocs[slotOf(k)], top));
				};

				// Fallback placement for slides without an SVG slot: ratios of the viewport, size in px
				const FALLBACK_SLIDES = [
					{ xRatio: 0.58, yRatio: 0.24, size: 160 },
					{ xRatio: 0.12, yRatio: 0.24, size: 190 },
					{ xRatio: 0.58, yRatio: 0.24, size: 160 },
					{ xRatio: 0.44, yRatio: 0.2, size: 140 },
				];

				const refreshBuffers = () => {
					setSlideTops();
					const configs = getConstellationConfigs();
					const t0 = buildTargetsFromLogo(loadedImages[0] || null, configs[0]?.settings);
					const count = t0.length;

					// Slides without a constellation config yield null and their stars shrink in place
					const sampleSlide = (k: number, defaultX: number, defaultY: number, defaultSize: number) => {
						const cfg = configs[k];
						if (!cfg) return null;
						return sampleShapePoints(
							loadedImages[k] || null,
							document.getElementById(`constellationSlot-${k}`),
							count,
							defaultX,
							defaultY,
							cfg.settings?.size ?? defaultSize,
							cfg.settings
						);
					};

					// Virtual slot and hero slot both use the hero targets and config
					const slotTargets: (SlidePoint[] | null)[] = [t0, t0];
					for (let k = 1; k < REAL_SLIDE_COUNT; k++) {
						const fb = FALLBACK_SLIDES[Math.min(k - 1, FALLBACK_SLIDES.length - 1)];
						slotTargets.push(sampleSlide(k, Math.round(width * fb.xRatio), Math.round(height * fb.yRatio), fb.size));
					}

					const slotConfigs = [configs[0] ?? null, ...configs];
					updateParticleBuffer(slotTargets, slotConfigs);
				};

				const loadAllShapes = () => {
					const configs = getConstellationConfigs();
					const urls = configs.map((c) => c?.svg ?? null);
					const pendingCount = urls.filter((url) => url !== null).length;
					let loadedTotal = 0;
					const imgs = urls.map((url) => {
						if (url === null) return null;
						const im = new Image();
						im.src = url;
						const onDone = () => {
							loadedTotal++;
							if (loadedTotal === pendingCount) {
								loadedImages = imgs;
								refreshBuffers();
							}
						};
						im.onload = onDone;
						im.onerror = onDone;
						return im;
					});
				};

				const resize = () => {
					width = window.innerWidth;
					height = window.innerHeight;
					dpr = Math.min(window.devicePixelRatio || 1, 2);

					canvas.width = width * dpr;
					canvas.height = height * dpr;
					gl.viewport(0, 0, canvas.width, canvas.height);

					gl.useProgram(program);
					gl.uniform2f(uResolutionLoc, width, height);
					gl.uniform1f(uPixelRatioLoc, dpr);

					refreshBuffers();
				};

				// Initial buffer with fallback
				resize();
				loadAllShapes();

				window.addEventListener("resize", resize, { passive: true });

				// Scroll states: sunrise progression spans full page
				let dawnAlpha = 0;
				let cachedSkyMaxScroll = 1;

				const updateSkyMaxScroll = () => {
					cachedSkyMaxScroll = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
				};
				updateSkyMaxScroll();
				window.addEventListener("resize", updateSkyMaxScroll, { passive: true });

				const updateSkyOnScroll = () => {
					const scrollY = window.scrollY;

					// Sunrise progression: spans the entire page using SUNRISE_CONFIG (1 = linear, n = exponential)
					const pageProgress = Math.min(Math.max(scrollY / cachedSkyMaxScroll, 0), 1);
					dawnAlpha = calculateDawnAlpha(pageProgress, SUNRISE_CONFIG.exponent, SUNRISE_CONFIG.curve);

					if (dawnOverlay) {
						dawnOverlay.style.opacity = `${dawnAlpha * SUNRISE_CONFIG.maxOverlayOpacity}`;
					}
					if (dawnSunDisc) {
						const discOpacity = Math.pow(dawnAlpha, SUNRISE_CONFIG.sunDisc.exponent);
						const discTranslateY = (1 - dawnAlpha) * SUNRISE_CONFIG.sunDisc.translateYStart;
						const discScale =
							SUNRISE_CONFIG.sunDisc.scaleMin +
							dawnAlpha * (SUNRISE_CONFIG.sunDisc.scaleMax - SUNRISE_CONFIG.sunDisc.scaleMin);
						dawnSunDisc.style.opacity = `${discOpacity}`;
						dawnSunDisc.style.transform = `translateX(-50%) translateY(${discTranslateY}px) scale(${discScale}) translateZ(0)`;
					}
				};

				updateSkyOnScroll();

				// WebGL Blend Mode for additive starlight
				gl.enable(gl.BLEND);
				gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

				// Pull rate (1/s) of the flight, scaled by the screen progress
				const STAR_RUBBER_STIFFNESS = 0.5;
				// Distance (in slides) from a slide within which the screen counts as resting on it
				const SLIDE_REST_ZONE = 0.05;
				// Slide-units tolerance for treating stars as exactly on a slide
				const SLIDE_SNAP_EPSILON = 0.001;
				let starsSlidePosition = 0;
				let lastFrameTime = performance.now();
				let lastScrollPos = -1;
				let scrollDir = 1;

				// Fractional slide position: 1.01 means just past slide 1
				const getScrollPosition = () => {
					const offsets = getSlideOffsets();
					const y = window.scrollY;
					let i = 0;
					while (i + 1 < offsets.length && y >= offsets[i + 1].top) i++;
					if (i + 1 >= offsets.length) return i;
					const span = offsets[i + 1].top - offsets[i].top;
					return i + (y - offsets[i].top) / span;
				};

				// The slide pair follows the screen at once; the stars chase the current slide
				const stepFlight = (dt: number) => {
					const y = getScrollPosition() + HERO_SLOT;
					if (lastScrollPos < 0) {
						lastScrollPos = y;
						// Load at the top: stars start on the virtual slide and fly to the hero
						starsSlidePosition = Math.round(y) === HERO_SLOT ? VIRTUAL_SLOT : Math.round(y);
					}
					const dy = y - lastScrollPos;
					lastScrollPos = y;
					if (Math.abs(dy) > 1e-4) scrollDir = Math.sign(dy);

					const nearSlide = Math.round(y);
					let prevSlideIndex: number;
					let currentSlideIndex: number;
					if (Math.abs(y - nearSlide) < SLIDE_REST_ZONE) {
						if (scrollDir > 0) {
							currentSlideIndex = Math.min(Math.max(nearSlide, HERO_SLOT), SLIDE_COUNT - 1);
							prevSlideIndex = currentSlideIndex - 1;
						} else {
							currentSlideIndex = Math.min(nearSlide, SLIDE_COUNT - 2);
							prevSlideIndex = currentSlideIndex + 1;
						}
					} else if (scrollDir > 0) {
						prevSlideIndex = Math.min(Math.floor(y), SLIDE_COUNT - 2);
						currentSlideIndex = prevSlideIndex + 1;
					} else {
						currentSlideIndex = Math.min(Math.floor(y), SLIDE_COUNT - 2);
						prevSlideIndex = currentSlideIndex + 1;
					}
					const distance = Math.sign(currentSlideIndex - prevSlideIndex);
					const scrollProgress = Math.min(Math.max((y - prevSlideIndex) * distance, 0), 1);
					const starsProgress = (starsSlidePosition - prevSlideIndex) * distance;
					// P = S * sp * (1 - p), zero in the dead zone where resting stars wait for the screen
					const rubberPower = STAR_RUBBER_STIFFNESS * Math.pow((1 - starsProgress) - (starsProgress - scrollProgress), 2);
					// Stars chase the screen but never pass it
					// const nextStarsProgress = Math.min(Math.max(scrollProgress, starsProgress), starsProgress + rubberPower * dt);
					const nextStarsProgress = starsProgress + rubberPower * dt;
					starsSlidePosition = prevSlideIndex + distance * nextStarsProgress;
					if (Math.abs(1 - nextStarsProgress) < SLIDE_SNAP_EPSILON) starsSlidePosition = currentSlideIndex;
				};

				let time = 0;
				const render = () => {
					time += 0.022;

					updateSkyOnScroll();

					const now = performance.now();
					const dt = Math.min((now - lastFrameTime) / 1000, 0.1);
					lastFrameTime = now;
					stepFlight(dt);
					const slideProgress = starsSlidePosition;

					// Starlight softly dims as the golden sunrise reaches its peak at the bottom
					const skyFade = Math.max(
						1.0 - dawnAlpha * SUNRISE_CONFIG.starDimmingFactor,
						SUNRISE_CONFIG.minStarOpacity
					);

					gl.clearColor(0, 0, 0, 0);
					gl.clear(gl.COLOR_BUFFER_BIT);

					gl.useProgram(program);
					gl.uniform1f(uTimeLoc, time);
					gl.uniform1f(uSlideProgressLoc, slideProgress);
					gl.uniform1f(uScrollYLoc, window.scrollY);
					gl.uniform1f(uRubberLoc, STAR_RUBBER_STIFFNESS);
					gl.uniform1f(uSkyFadeLoc, skyFade);

					gl.drawArrays(gl.POINTS, 0, particleCount);

					requestAnimationFrame(render);
				};

				render();
		};

		initCosmicField();
	</script>
</Layout>
