---
import Layout from "../layouts/Layout.astro";

const site = {
  brand: "Твій STEP",
  title: "Твій крок. Твій шлях. Твій степ.",
  subtitle:
    "Для різного досвіду - від першого кроку до довгих дистанцій, без тиску і гонки за цифрами.",
  social: {
    telegram: "https://t.me/+S6yg2WuoqAI0ZmVi",
    instagram: "https://www.instagram.com/tviy.step",
    tiktok: "https://www.tiktok.com/@tviy.step?_r=1"
  }
};

const titleLines = ["Твій крок.", "Твій шлях.", "Твій степ."];

const heroImageSrc = "/images/home/cycling-crew-banner.webp";

const navLinks = [
  { href: "#about", label: "Про спільноту" },
  { href: "#meaning", label: "Що означає назва" },
  { href: "#join", label: "Як долучитись" },
  { href: "#team", label: "Команда" },
  { href: "#faq", label: "FAQ" }
];

const manifesto = [
  {
    title: "Ми про людей",
    text: "Ми різні за темпом і досвідом, але нас об'єднує бажання рухатися разом."
  },
  {
    title: "Ми про ритм",
    text: "Рух стає частиною життя, коли є підтримка, простір і зрозумілий перший крок."
  },
  {
    title: "Ми про свободу руху",
    text: "Рух - це простір для зустрічей, підтримки й нових знайомств без прив'язки до конкретного місця."
  }
];

const meaning = [
  {
    label: "ТВІЙ",
    text: "Про відчуття приналежності: твій темп, твоє місце, твої люди."
  },
  {
    label: "STEP",
    text: "Про щоденний крок вперед: невеликий, але чесний і регулярний."
  },
  {
    label: "СТЕП",
    text: "Про простір, свободу, горизонт і витривалість українського ландшафту."
  }
];

const joinSteps = [
  {
    title: "Приєднайся до Telegram-каналу",
    text: "Це головна точка входу в спільноту. Там живий діалог, анонси та знайомства."
  },
  {
    title: "Запитай у чаті про найближчий вихід",
    text: "Просто напиши, чи хтось планує рух найближчим часом. Це нормальний спосіб почати."
  },
  {
    title: "Стеж за сповіщеннями від команди та учасників",
    text: "Учасники самі створюють динаміку: хто, де і коли рухається."
  }
];

const faq = [
  {
    q: "Чи можна прийти, якщо я новачок?",
    a: "Так. Спільнота відкрита для всіх рівнів. Тут підтримують перший крок, а не оцінюють темп."
  },
  {
    q: "Чи є зараз фіксований графік?",
    a: "Ні, зараз немає стабільного розкладу. Домовленості відбуваються в Telegram."
  },
  {
    q: "Скільки коштує участь?",
    a: "Участь у спільноті безкоштовна."
  },
  {
    q: "Що важливо перед першим кроком?",
    a: "Зручний одяг, вода і готовність знайомитися. Усе інше формується в процесі."
  }
];

const icons = {
  telegram: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>`,
  instagram: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>`,
  tiktok: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>`
};

const pageTitle = `${site.brand} - ${site.title}`;
const pageDescription = "Твій STEP - відкрита спільнота руху. Рух у своєму темпі, атмосфера підтримки, люди та горизонт.";
---

<Layout title={pageTitle} description={pageDescription} lang="uk">
  <style>
      :root {
        --bg: #f4f0e8;
        --ink: #1b1b1f;
        --muted: rgba(27, 27, 31, 0.74);
        --sand: #d8c28a;
        --line: rgba(27, 27, 31, 0.12);
        --panel: rgba(255, 255, 255, 0.2);
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        color: var(--ink);
        line-height: 1.6;
        font-family: "Segoe UI", "Inter", sans-serif;
        background:
          radial-gradient(circle at 10% 8%, rgba(216, 194, 138, 0.28), transparent 35%),
          radial-gradient(circle at 86% 12%, rgba(27, 27, 31, 0.1), transparent 30%),
          var(--bg);
        animation: page-fade 540ms ease-out;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(1140px, calc(100% - 32px));
        margin: 0 auto;
      }

      .topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(244, 240, 232, 0.84);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--line);
      }

      .nav {
        min-height: 74px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0;
      }

      .brand-mark {
        width: 64px;
        height: 64px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .brand-mark img {
        width: 64px;
        height: 64px;
        display: block;
        object-fit: contain;
      }

      .nav-links,
      .nav-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .nav-links {
        gap: 24px;
        color: var(--muted);
      }

      .button {
        min-height: 46px;
        padding: 0 20px;
        border-radius: 999px;
        border: 1px solid var(--ink);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s ease;
        font-weight: 600;
      }

      .button:hover { transform: translateY(-1px); }

      .button.primary {
        color: var(--bg);
        background: var(--ink);
      }

      .button.secondary {
        background: transparent;
      }

      .button.icon-btn {
        padding: 0;
        width: 36px;
        min-height: 36px;
        border: none;
        background: transparent !important;
        color: var(--ink);
      }

      main section {
        padding: 78px 0;
      }

      .hero {
        padding-top: 68px;
      }

      .hero > .container > div:first-child {
        animation: rise-in 760ms 80ms both cubic-bezier(0.2, 0.65, 0.2, 1);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 30px;
        align-items: stretch;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 14px;
        font-size: 0.74rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 700;
      }

      h1 {
        margin: 0 0 14px;
        font-size: clamp(2.8rem, 5.4vw, 5.2rem);
        line-height: 0.92;
        letter-spacing: -0.05em;
      }

      .title-line {
        display: block;
      }

      .lead {
        margin: 0 0 20px;
        color: var(--muted);
        font-size: 1.05rem;
        max-width: 56ch;
      }

      .hero-actions {
        margin-bottom: 16px;
      }

      .hero-visual {
        border: 1px solid var(--line);
        border-radius: 30px;
        padding: 0;
        background: transparent;
        display: block;
        min-height: 460px;
        box-shadow: 0 26px 46px rgba(27, 27, 31, 0.18);
        overflow: hidden;
        position: relative;
        animation: rise-in 820ms 180ms both cubic-bezier(0.2, 0.65, 0.2, 1);
      }

      .hero-visual::before {
        content: none;
      }

      .hero-visual img {
        width: 100%;
        height: 100%;
        min-height: 460px;
        display: block;
        object-fit: cover;
        border: 0;
        border-radius: 0;
      }

      .hero-visual video {
        width: 100%;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.18);
        aspect-ratio: 16 / 9;
        object-fit: cover;
      }



      .photo-card {
        display: grid;
        gap: 10px;
      }

      .photo-card img {
        width: 100%;
        border-radius: 16px;
        border: 1px solid var(--line);
      }

      .photo-caption {
        color: var(--muted);
        font-size: 0.9rem;
      }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 22px;
        margin-bottom: 24px;
      }


      .section-head h2 {
        margin: 0;
        font-size: clamp(2rem, 4.2vw, 3.2rem);
        letter-spacing: -0.05em;
        line-height: 1.03;
      }

      .section-head p {
        margin: 0;
        color: var(--muted);
        max-width: 620px;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
      }

      .card {
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 22px;
        padding: 22px 20px;
        transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
      }

      .card:hover {
        transform: translateY(-4px);
        border-color: rgba(27, 27, 31, 0.24);
        box-shadow: 0 14px 30px rgba(27, 27, 31, 0.08);
      }

      .card h3 {
        margin: 0 0 8px;
        font-size: 1.24rem;
        letter-spacing: -0.03em;
      }

      .card p {
        margin: 0;
        color: var(--muted);
      }

      .label {
        display: inline-block;
        margin-bottom: 10px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(216, 194, 138, 0.72);
        background: rgba(216, 194, 138, 0.2);
        font-size: 0.75rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .faq details {
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 12px 14px;
        background: var(--panel);
      }

      .faq details + details {
        margin-top: 10px;
      }

      .faq summary {
        cursor: pointer;
        font-weight: 600;
      }

      .faq p {
        margin: 10px 0 0;
      }

      .team-note {
        border: 1px dashed var(--line);
        border-radius: 18px;
        padding: 16px;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .reveal {
        opacity: 0;
        transform: translateY(28px);
        transition: opacity 640ms cubic-bezier(0.2, 0.65, 0.2, 1), transform 640ms cubic-bezier(0.2, 0.65, 0.2, 1);
      }

      .reveal.in-view {
        opacity: 1;
        transform: translateY(0);
      }

      .stagger > * {
        transition-delay: 0ms;
      }

      .stagger.in-view > :nth-child(1) { transition-delay: 40ms; }
      .stagger.in-view > :nth-child(2) { transition-delay: 140ms; }
      .stagger.in-view > :nth-child(3) { transition-delay: 240ms; }
      .stagger.in-view > :nth-child(4) { transition-delay: 340ms; }

      @keyframes page-fade {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      @keyframes rise-in {
        from {
          opacity: 0;
          transform: translateY(26px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes drift {
        from { transform: translate3d(-1.8%, 0, 0); }
        to { transform: translate3d(2.2%, -2.2%, 0); }
      }




      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation: none !important;
          transition: none !important;
          scroll-behavior: auto !important;
        }

        .reveal {
          opacity: 1;
          transform: none;
        }
      }

      footer {
        border-top: 1px solid var(--line);
        padding: 28px 0 52px;
      }

      .footer-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        color: var(--muted);
      }

      .social-icon {
        color: var(--ink);
        transition: transform 0.2s ease;
        display: flex;
      }

      .social-icon:hover {
        transform: scale(1.1);
      }

      @media (max-width: 980px) {
        .hero-grid,
        .grid-3,
        .grid-2 {
          grid-template-columns: 1fr;
        }

        .hero-visual {
          min-height: 0;
          aspect-ratio: auto;
        }

        .hero-visual img {
          min-height: 0;
          height: auto;
          object-fit: contain;
          object-position: 54% 50%;
        }

        .eyebrow {
          margin-bottom: 10px;
          font-size: 0.7rem;
        }

        h1 {
          margin-bottom: 12px;
          line-height: 0.96;
        }

        .lead {
          font-size: 1rem;
          margin-bottom: 16px;
        }

        .hero-actions {
          margin-bottom: 8px;
          gap: 10px;
          flex-wrap: wrap;
        }

        .section-head {
          display: block;
        }

        .section-head p {
          margin-top: 10px;
        }

        .nav-links {
          display: none;
        }
      }
    </style>

    <header class="topbar">
      <div class="container nav">
        <a href="/" class="brand">
          <span class="brand-mark"><img src="/images/home/tviy_step_logo64.png" alt="Логотип Твій STEP" /></span>
        </a>

        <nav class="nav-links" aria-label="Головна навігація">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>

        <div class="nav-actions">
          <a class="button secondary icon-btn social-icon" href={site.social.instagram} target="_blank" rel="noreferrer" aria-label="Instagram"><Fragment set:html={icons.instagram} /></a>
          <a class="button secondary icon-btn social-icon" href={site.social.tiktok} target="_blank" rel="noreferrer" aria-label="TikTok"><Fragment set:html={icons.tiktok} /></a>
          <a class="button primary icon-btn social-icon" href={site.social.telegram} target="_blank" rel="noreferrer" aria-label="Telegram"><Fragment set:html={icons.telegram} /></a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div>
              <span class="eyebrow">Твій ритм. Твої люди.</span>
            <h1>
              {titleLines.map((line) => (
                <span class="title-line">{line}</span>
              ))}
            </h1>
            <p class="lead">{site.subtitle}</p>

            <div class="nav-actions hero-actions">
              <a class="button primary" href={site.social.telegram} target="_blank" rel="noreferrer">Приєднатися в Telegram</a>
              <a class="button secondary" href="#join">Як це працює</a>
            </div>

          </div>

          <aside class="hero-visual" aria-label="Обкладинка спільноти">
            <img src={heroImageSrc} alt="Головне фото спільноти" />
          </aside>
        </div>
      </section>

      <section id="about" class="reveal">
        <div class="container">
          <div class="section-head reveal">
            <h2>Хто ми</h2>
            <p>
              Твій STEP - це більше, ніж спортивний клуб. Це простір свободи, руху і підтримки,
              де кожен крок робиться разом.
            </p>
          </div>

          <div class="grid-3 reveal stagger">
            {manifesto.map((item) => (
              <article class="card reveal">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="meaning" class="reveal">
        <div class="container">
          <div class="section-head reveal">
            <h2>Що означає назва</h2>
            <p>
              У назві одночасно є особистий сенс, щоденна дія і культурний образ простору.
            </p>
          </div>

          <div class="grid-3 reveal stagger">
            {meaning.map((item) => (
              <article class="card reveal">
                <span class="label">{item.label}</span>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="reveal">
        <div class="container">
          <div class="section-head reveal">
            <h2>Люди та атмосфера</h2>
            <p>
              Тут важливе відчуття "я тут свій" - підтримка, довіра і жива атмосфера людей поруч.
            </p>
          </div>

          <div class="grid-2 reveal stagger">
            <article class="card reveal">
              <div class="photo-card">
                <img src="/images/home/community-flag-group.webp" alt="Учасники Твій STEP після спільного руху з прапором клубу" />
                <div class="photo-caption">
                  Після спільного кроку: команда, усмішки і прапор Твій STEP як знак спільної дороги.
                </div>
              </div>
            </article>
            <article class="card reveal">
              <div class="photo-card">
                <img src="/images/home/community-skyline-group.webp" alt="Учасники спільноти на оглядовому майданчику" />
                <div class="photo-caption">
                  Після руху: розмова, відновлення і відчуття, що ти серед своїх людей.
                </div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="join" class="reveal">
        <div class="container">
          <div class="section-head reveal">
            <h2>Як долучитися</h2>
          </div>

          <div class="grid-3 reveal stagger">
            {joinSteps.map((step, index) => (
              <article class="card reveal">
                <h3>{index + 1}. {step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="team" class="reveal">
        <div class="container">
          <div class="section-head reveal">
            <h2>Команда</h2>
            <p>
              Люди, які тримають ритм спільноти і підтримують атмосферу відкритості.
            </p>
          </div>

          <div class="grid-3 reveal stagger" style="margin-bottom: 14px;">
            <article class="card reveal">
              <span class="label">Координація старту</span>
              <p>Підтримують спільний темп і допомагають новим учасникам пройти перший маршрут без тиску.</p>
            </article>
            <article class="card reveal">
              <span class="label">Координація маршрутів</span>
              <p>Продумують безпечні міські траєкторії, щоб рухатися було комфортно в будь-якому досвіді.</p>
            </article>
            <article class="card reveal">
              <span class="label">Координація спільноти</span>
              <p>Тримають тепло спільноти: знайомства, підтримка, розмова після руху і відчуття приналежності.</p>
            </article>
          </div>

          <div class="team-note photo-card reveal">
            <img src="/images/home/community-view-selfie.webp" alt="Команда Твій STEP на фоні річки та міського горизонту" />
            <div class="photo-caption">
              Живий погляд зсередини спільноти: люди, горизонт і легкість бути разом у русі.
            </div>
          </div>
        </div>
      </section>

      <section id="faq" class="faq reveal">
        <div class="container">
          <div class="section-head reveal">
            <h2>Питання та відповіді</h2>
            <p>Коротко закриваємо головні запитання перед першим кроком.</p>
          </div>

          {faq.map((item) => (
            <details class="reveal">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-row">
        <div class="brand">
          <span class="brand-mark"><img src="/images/home/tviy_step_logo64.png" alt="Логотип Твій STEP" /></span>
        </div>

        <div class="footer-links">
          {navLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <a class="social-icon" href={site.social.telegram} target="_blank" rel="noreferrer" aria-label="Telegram"><Fragment set:html={icons.telegram} /></a>
          <a class="social-icon" href={site.social.instagram} target="_blank" rel="noreferrer" aria-label="Instagram"><Fragment set:html={icons.instagram} /></a>
          <a class="social-icon" href={site.social.tiktok} target="_blank" rel="noreferrer" aria-label="TikTok"><Fragment set:html={icons.tiktok} /></a>
        </div>
      </div>
    </footer>

    <script>
      const items = Array.from(document.querySelectorAll('.reveal'));

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.14, rootMargin: '0px 0px -8% 0px' });

        items.forEach((item) => io.observe(item));
      } else {
        items.forEach((item) => item.classList.add('in-view'));
      }
    </script>
 </Layout>
