---
import Layout from "../layouts/Layout.astro";

const site = {
	brand: 'Твій STEP',
	tagline: 'Твій крок. Твій шлях. Твій степ.',
	social: {
		telegram: 'https://t.me/+S6yg2WuoqAI0ZmVi',
		instagram: 'https://www.instagram.com/tviy.step',
		tiktok: 'https://www.tiktok.com/@tviy.step?_r=1',
	},
};

// Global starlight particle system configuration
// - ambient: Fixed background stars (twinkling cosmic sky)
// - defaultConstellation: Baseline starlight characteristics inherited by all slide silhouettes
const STAR_CONFIG = {
	driftFraction: 0.006, // drift amplitude as a fraction of the hero logo width
	motion: {
		staggerSpan: 0.35, // share of the flight window spread across star start times
		driftSpeedX: 1.4,
		driftSpeedY: 1.1,
		swaySpeed: 1.2,
		swayRankPhase: 0.8, // sway phase offset per rank
		swayPhasePerWidth: 2.07, // sway phase across one hero logo width (0.006 per px at a 345 px logo)
		streamWidthFraction: 0.07, // stream width as a fraction of the hero logo width
		spreadScale: 0.12, // share of the hero spread applied mid-flight
		twinkleSpeed: 3.2,
		twinkleBrightnessSwing: 0.3,
		twinkleBase: 0.72,
		twinkleAmplitude: 0.28,
		brightnessBase: 0.8,
		flightSizeSwell: 0.25, // point size growth at mid-flight
		swayCycles: 1.5, // sway waves across one flight
	},
	ambient: {
		densityDivider: 2600, // screen area (w*h) / divider gives count
		sizeMin: 1.5,
		sizeMax: 3.3,
		brightnessMin: 0.8,
		brightnessMax: 1.2,
		rayStrengthMin: 0.10,
		rayStrengthMax: 0.30,
		featuredRatio: 0.08,
		featuredSizeMin: 5.0,
		featuredSizeMax: 9.0,
		featuredRayMin: 0.65,
		featuredRayMax: 0.90,
	},
	sprite: {
		discStart: 0.06, // star disc edge start (0-1 of point radius)
		coreSharpness: 2.2,
		rayFalloff: 28, // emitted with toFixed(1) because GLSL needs a float literal
		rayInnerEdge: 0.15,
		rayGain: 0.95,
		coreArea: 0.150904, // filtered core coverage area
		alphaCutoff: 0.01,
		whiteCoreBase: 0.59228,
		whiteBrightMin: 0.7,
		whiteBrightMax: 2.2,
		whiteCoreGain: 0.85,
		colorEnergyGain: 0.42,
	},
	defaultConstellation: {
		alphaThreshold: 35, // 0-255 opacity threshold to sample star positions from SVG
		density: 1, // candidate sample points per star
		gap: 0.008, // spacing as a fraction of the logo's fitted width
		featuredRatio: 0.1, // fraction of stars that become cross-spikes
		goldStarFraction: 0.25, // fraction of hero stars drawn in gold
		sizeMin: 0.005, // star diameters as fractions of the hero logo width
		sizeMax: 0.01,
		brightnessMin: 1.1,
		brightnessMax: 1.6,
		rayStrengthMin: 0.25,
		rayStrengthMax: 0.60,
		featuredSizeMin: 0.01,
		featuredSizeMax: 0.02,
		featuredRayMin: 1,
		featuredRayMax: 5,
		featuredBrightnessMin: 1.8,
		featuredBrightnessMax: 2.5,
		colorIvory: { r: 0.96, g: 0.94, b: 0.92 },
		colorGold: { r: 0.88, g: 0.78, b: 0.56 },
	},
};

// Scrolltelling blocks for the homepage
// Each block contains texts and images to be displayed in a storytelling manner on the homepage.
// If there are a few texts in the block - they are just separate paragraphs.
// If there are a few images in the block - the images should be automatically scrollable. There should be a manual way to scroll through them as well.
// constellationEffect: SVG silhouette and per-slide starlight settings (inherits defaults from STAR_CONFIG.defaultConstellation).
const infoBlocks = [
	{
		num: '01',
		constellationEffect: {
			svg: '/images/home/logo.svg',
			settings: {
				pivot: 'left',
				// Top-left TVIY wordmark: finer sampling
				regions: [
					{ 	
						minX: 0, minY: 0, 
						maxX: 0.27, maxY: 0.165, 
						gap: 0.003, 
						sizeMin: 0.0025, // star diameters as fractions of the hero logo width
						sizeMax: 0.005,
						featuredSizeMin: 0.005,
						featuredSizeMax: 0.01,
					},
				],
			},
		},
		texts: [
			'«Твій STEP» — це вільна спортивна спільнота для тих, хто любить бігати, тренуватися, їздити на велосипеді, відкривати нові маршрути і зустрічати своїх людей.'
		],
		images: [
			'/images/home/groupFlag1.webp',
			'/images/home/groupFlag2.webp',
			'/images/home/groupFlag5.webp'
		]
	},
	{
		num: '02',
		constellationEffect: {
			svg: '/images/home/calisthenics.svg',
			settings: {
				pivot: 'center',
			},
		},
		texts: [
			'Ми обʼєднуємо людей навколо бігу, велоспорту та функціональних тренувань на свіжому повітрі (калістеніка, бруси, перекладини). Ми працюємо без привʼязки до спортзалів та абонементів, перетворюючи міський та природний простір на майданчик для розвитку.'
		],
		images: [
			'/images/home/team.webp',
			'/images/home/team2.webp',
		]
	},
	{
		num: '03',
		constellationEffect: {
			svg: '/images/home/cyclist.svg',
			settings: {
				alphaThreshold: 20,
				pivot: 'center',
			},
		},
		texts: [
			'Назва спільноти має глибинний підтекст:<br>' +
			'«Степ» — це символ української волі і свободи, витривалості та безмежного простору;<br>' +
			'«STEP» — це щоденний крок вперед до кращої версії себе <br>' +
			'«твій» - це про відчуття приналежності до єдиної «зграї», де панує підтримка, рівність і свобода.',
			'«Твій STEP» - це більше ніж спортивний клуб. Це простір свободи, духу та руху, де кожен крок робиться разом.'
		],
		images: [
			'/images/home/groupFlag3.webp',
			'/images/home/groupFlag4.webp',
		]
	},
	{
		num: '04',
		constellationEffect: {
			svg: '/images/home/runner.svg',
			settings: {
				pivot: 'center',
			},
		},
		texts: [
			'Неважливо, скільки кілометрів.<br>' +
			'Неважливо, який темп.<br>' +
			'Неважливо, ти біжиш, крутиш педалі чи просто робиш перший крок.<br>' +
			'Важливо, що нам подобається одне й те саме — бути в русі і бути серед своїх.'
		],
		images: [
			'/images/home/friends3.webp',
			'/images/home/friends4.webp',
			'/images/home/friends1.webp',
			'/images/home/friends2.webp',
			'/images/home/friends5.webp',
		],
	},
	{
		num: '05',

		// there should be the join button here (join to Telegram channel)
		texts: [
			'Можна прийти одному.<br>' +
			'Можна з другом.<br>' +
			'Можна навіть просто познайомитися.',
			'Твій Step починається з першого кроку.'
		],
		images: []
	}
];

const icons = {
	telegram: `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>`,
	instagram: `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>`,
	tiktok: `<svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>`,
	arrowRight: `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`
};

const pageTitle = `${site.brand} — ${site.tagline}`;
const pageDescription = 'Вільна спортивна спільнота Києва. Біг, вело, вуличні тренування, відкритий простір та люди поруч. Твій темп. Твій шлях. Твій степ.';
---

<Layout title={pageTitle} description={pageDescription} lang="uk">
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&display=swap"
			rel="stylesheet"
		/>
	</Fragment>

	<style>
		:root {
			--graphite: #18191d;
			--graphite-card: #202228;
			--graphite-deep: #111215;
			--ivory: #f4f0e8;
			--sand: #d8c28a;
			--sand-glow: rgba(216, 194, 138, 0.28);
			--sand-subtle: rgba(216, 194, 138, 0.12);
			--muted-ivory: rgba(244, 240, 232, 0.68);
			--line-graphite: rgba(244, 240, 232, 0.12);
			--line-gold: rgba(216, 194, 138, 0.35);
			--font-body: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
			--font-display: "Playfair Display", Georgia, serif;
			--topbar-height: 72px;
		}

		* {
			box-sizing: border-box;
		}

		html {
			background-color: var(--graphite-deep);
		}

		body {
			margin: 0;
			color: var(--ivory);
			background-color: var(--graphite-deep);
			font-family: var(--font-body);
			line-height: 1.6;
			overflow-x: clip;
			position: relative;
			-webkit-font-smoothing: antialiased;
		}

		/* Fixed Cosmic Particle Canvas & Sunrise Atmosphere */
		.sky-backdrop-fixed {
			position: fixed;
			inset: 0;
			pointer-events: none;
			z-index: 0;
			overflow: hidden;
		}

		#starCanvas {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			display: block;
			z-index: 1;
		}

		/* Sunrise Sky Gradient Overlay: starts dark at top, scrolls into warm Kyiv dawn */
		.dawn-overlay {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			z-index: 2;
			opacity: 0;
			pointer-events: none;
			will-change: opacity;
			transform: translateZ(0);
			background:
				radial-gradient(ellipse 120% 75% at 50% 100%, rgba(216, 194, 138, 0.52) 0%, rgba(216, 170, 110, 0.3) 35%, rgba(160, 110, 70, 0.12) 65%, transparent 85%),
				linear-gradient(180deg, rgba(24, 25, 29, 0) 0%, rgba(32, 29, 36, 0.25) 40%, rgba(55, 45, 42, 0.5) 70%, rgba(100, 75, 50, 0.4) 100%);
		}

		.dawn-sun-disc {
			position: absolute;
			bottom: -80px;
			left: 50%;
			transform: translateX(-50%) translateY(85px) scale(0.85) translateZ(0);
			width: min(850px, 92vw);
			height: 400px;
			border-radius: 50% 50% 0 0;
			background: radial-gradient(circle at 50% 85%, rgba(255, 248, 235, 0.75) 0%, rgba(244, 240, 232, 0.55) 20%, rgba(216, 194, 138, 0.35) 45%, rgba(200, 140, 90, 0.12) 65%, rgba(17, 18, 21, 0) 80%);
			opacity: 0;
			pointer-events: none;
			will-change: opacity, transform;
		}

		a {
			color: inherit;
			text-decoration: none;
		}

		.container {
			width: min(1200px, calc(100% - 40px));
			margin: 0 auto;
			position: relative;
			z-index: 2;
		}

		/* ========================================================
		   SVG BACKGROUND SCROLL RIBBON
		   ======================================================== */
		.scroll-ribbon-container {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			pointer-events: none;
			z-index: 1;
			overflow: hidden;
		}

		.scroll-ribbon-svg {
			width: 100%;
			height: 100%;
			overflow: visible;
		}

		.ribbon-spine {
			fill: none;
			stroke: url(#ribbonGradient);
			stroke-width: 2.2;
			stroke-linecap: round;
			stroke-dasharray: 6000;
			stroke-dashoffset: 6000;
			transition: stroke-dashoffset 80ms linear;
			transform: translateZ(0);
		}

		.ribbon-accent {
			fill: none;
			stroke: rgba(244, 240, 232, 0.08);
			stroke-width: 1;
			stroke-linecap: round;
			stroke-dasharray: 12 8;
		}

		/* ========================================================
		   NAVBAR
		   ======================================================== */
		.topbar {
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			z-index: 100;
			background: rgba(24, 25, 29, 0.76);
			backdrop-filter: blur(16px);
			-webkit-backdrop-filter: blur(16px);
			border-bottom: 1px solid var(--line-graphite);
			transition: background 0.3s ease, border-color 0.3s ease;
		}

		.nav-wrapper {
			min-height: var(--topbar-height);
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 16px;
		}

		.brand {
			display: inline-flex;
			align-items: center;
			gap: 12px;
		}

		.brand-mark {
			width: 44px;
			height: 44px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			border-radius: 50%;
			background: rgba(244, 240, 232, 0.04);
			border: 1px solid rgba(216, 194, 138, 0.25);
			padding: 6px;
			transition: transform 0.3s ease, border-color 0.3s ease;
		}

		.brand:hover .brand-mark {
			transform: scale(1.05);
			border-color: var(--sand);
		}

		.brand-mark img {
			width: 100%;
			height: 100%;
			object-fit: contain;
		}

		.brand-text {
			font-family: var(--font-display);
			font-size: 1.25rem;
			font-weight: 700;
			letter-spacing: 0.04em;
			color: var(--ivory);
		}

		.brand-text span {
			color: var(--sand);
		}

		.nav-menu {
			display: flex;
			align-items: center;
			gap: 32px;
		}

		.nav-link {
			font-size: 0.88rem;
			font-weight: 500;
			letter-spacing: 0.05em;
			text-transform: uppercase;
			color: var(--muted-ivory);
			position: relative;
			padding: 4px 0;
			transition: color 0.2s ease;
		}

		.nav-link::after {
			content: "";
			position: absolute;
			left: 0;
			bottom: 0;
			width: 100%;
			height: 1px;
			background: var(--sand);
			transform: scaleX(0);
			transform-origin: left center;
			transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		}

		.nav-link:hover {
			color: var(--ivory);
		}

		.nav-link:hover::after {
			transform: scaleX(1);
		}

		.nav-actions {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.social-link {
			width: 40px;
			height: 40px;
			border-radius: 50%;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			border: 1px solid var(--line-graphite);
			background: rgba(255, 255, 255, 0.03);
			color: var(--ivory);
			transition: 0.25s ease;
		}

		.social-link:hover {
			border-color: var(--sand);
			color: var(--sand);
			transform: translateY(-2px);
			background: var(--sand-subtle);
		}

		.btn-cta-nav {
			padding: 0 18px;
			height: 40px;
			border-radius: 999px;
			background: var(--sand);
			color: var(--graphite-deep);
			font-weight: 600;
			font-size: 0.85rem;
			letter-spacing: 0.02em;
			display: inline-flex;
			align-items: center;
			gap: 8px;
			transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
		}

		.btn-cta-nav:hover {
			transform: translateY(-1px);
			background: #e2ce9a;
			box-shadow: 0 4px 18px rgba(216, 194, 138, 0.3);
		}

		.hero-actions {
			display: flex;
			align-items: center;
			gap: 16px;
			flex-wrap: nowrap;
		}

		.btn-primary {
			height: 52px;
			padding: 0 28px;
			border-radius: 999px;
			background: var(--sand);
			color: var(--graphite-deep);
			font-weight: 700;
			font-size: 0.96rem;
			letter-spacing: 0.02em;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 10px;
			transition: all 0.25s ease;
			box-shadow: 0 6px 24px rgba(216, 194, 138, 0.25);
		}

		.btn-primary:hover {
			transform: translateY(-2px);
			background: #e4d1a0;
			box-shadow: 0 10px 32px rgba(216, 194, 138, 0.4);
		}

		.btn-secondary {
			height: 52px;
			padding: 0 24px;
			border-radius: 999px;
			border: 1px solid var(--line-graphite);
			background: rgba(255, 255, 255, 0.03);
			color: var(--ivory);
			font-weight: 600;
			font-size: 0.94rem;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 8px;
			transition: all 0.25s ease;
		}

		.btn-secondary:hover {
			border-color: var(--line-gold);
			color: var(--sand);
			background: var(--sand-subtle);
			transform: translateY(-2px);
		}

		/* ========================================================
		   SCROLLTELLING CHAPTERS (Cinematic Option B)
		   ======================================================== */
		.storytelling-wrapper {
			position: relative;
			padding: 0;
		}

		.slide-constellation-slot {
			width: min(180px, 36vw);
			aspect-ratio: 1 / 1;
			margin-bottom: 24px;
			pointer-events: none;
			border: 1px solid #fff; /* TEMP debug border */
		}

		.cta-constellation-slot {
			width: min(150px, 30vw);
			margin: 0 auto 20px;
		}

		.chapter-block {
			height: 100vh;
			height: 100svh;
			min-height: 100vh;
			min-height: 100svh;
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
			padding: calc(var(--topbar-height) + 16px) 0 32px;
			border-bottom: 1px solid rgba(244, 240, 232, 0.06);
			scroll-snap-align: start;
			scroll-snap-stop: always;
			box-sizing: border-box;
		}

		.chapter-block:last-child {
			border-bottom: none;
		}

		.chapter-layout {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: clamp(40px, 6vw, 80px);
			align-items: center;
		}

		.chapter-layout.reverse {
			grid-template-columns: 1fr 1fr;
		}

		.chapter-layout.reverse .chapter-text-col {
			order: 2;
		}

		.chapter-layout.reverse .chapter-media-col {
			order: 1;
		}

		@media (min-width: 961px) {
			.chapter-layout {
				align-items: stretch;
			}

			.chapter-text-col {
				display: flex;
				flex-direction: column;
			}

			/* Fills the text column width and the vertical space left under the text */
			.slide-constellation-slot {
				width: 100%;
				aspect-ratio: auto;
				flex: 1 1 0;
				min-height: 160px;
			}
		}

		.chapter-badge {
			font-size: 0.74rem;
			font-weight: 700;
			letter-spacing: 0.16em;
			text-transform: uppercase;
			color: var(--muted-ivory);
			padding: 4px 10px;
			border-radius: 999px;
			background: rgba(255, 255, 255, 0.04);
			border: 1px solid var(--line-graphite);
		}

		.chapter-title {
			font-family: var(--font-display);
			font-size: clamp(2.2rem, 3.8vw, 3.4rem);
			line-height: 1.14;
			font-weight: 600;
			letter-spacing: -0.015em;
			margin: 0 0 24px;
			color: var(--ivory);
			text-wrap: balance;
		}

		.chapter-desc {
			font-size: clamp(1.05rem, 1.5vw, 1.25rem);
			line-height: 1.7;
			color: var(--muted-ivory);
			margin: 0 0 20px;
		}

		.chapter-desc:last-child {
			margin-bottom: 0;
		}

		/* Decorative ribbon flourish under titles */
		.ribbon-flourish {
			width: 140px;
			height: 14px;
			margin-bottom: 24px;
		}

		.ribbon-flourish path {
			stroke: var(--sand);
			stroke-width: 2;
			fill: none;
			stroke-dasharray: 200;
			stroke-dashoffset: 200;
			transition: stroke-dashoffset 1.2s cubic-bezier(0.16, 1, 0.3, 1);
		}

		.in-view .ribbon-flourish path {
			stroke-dashoffset: 0;
		}

		/* CHAPTER 03 PILLARS */
		.pillars-grid {
			display: grid;
			gap: 16px;
			margin-top: 28px;
		}

		.pillar-card {
			padding: 18px 22px;
			border-radius: 18px;
			background: rgba(32, 34, 40, 0.65);
			border: 1px solid var(--line-graphite);
			backdrop-filter: blur(8px);
			transition: all 0.3s ease;
		}

		.pillar-card:hover {
			border-color: var(--line-gold);
			transform: translateX(4px);
			background: rgba(32, 34, 40, 0.95);
		}

		.pillar-head {
			display: flex;
			align-items: baseline;
			gap: 10px;
			margin-bottom: 6px;
		}

		.pillar-word {
			font-family: var(--font-display);
			font-size: 1.35rem;
			font-weight: 700;
			color: var(--sand);
			letter-spacing: 0.04em;
		}

		.pillar-desc {
			margin: 0;
			font-size: 0.92rem;
			line-height: 1.55;
			color: var(--muted-ivory);
		}

		/* CHAPTER 04 POETIC CADENCE */
		.poetic-box {
			display: grid;
			gap: 14px;
			border-left: 2px solid var(--sand);
			padding-left: 22px;
			margin: 28px 0;
		}

		.poetic-line {
			font-size: clamp(1.08rem, 1.6vw, 1.35rem);
			line-height: 1.5;
			color: var(--ivory);
			font-weight: 500;
		}

		.poetic-line.highlight {
			font-family: var(--font-display);
			font-style: italic;
			color: var(--sand);
			font-size: clamp(1.2rem, 1.8vw, 1.5rem);
			margin-top: 8px;
		}

		/* CHAPTER MEDIA: CAROUSEL WITH AUTO/MANUAL CONTROLS */
		.media-slider-container {
			position: relative;
			border-radius: 28px;
			overflow: hidden;
			background: var(--graphite-card);
			border: 1px solid var(--line-graphite);
			box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
			max-height: min(480px, calc(100vh - var(--topbar-height) - 80px));
		}

		.slider-track {
			display: flex;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
			-webkit-overflow-scrolling: touch;
		}

		.slider-track::-webkit-scrollbar {
			display: none;
		}

		.slider-slide {
			flex: 0 0 100%;
			scroll-snap-align: center;
			position: relative;
			aspect-ratio: 4 / 3.4;
			overflow: hidden;
			margin: 0;
		}

		.slider-slide img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 0.6s ease;
		}

		.media-slider-container:hover .slider-slide img {
			transform: scale(1.02);
		}

		.slider-overlay-gradient {
			position: absolute;
			inset: 0;
			background: linear-gradient(180deg, transparent 65%, rgba(17, 18, 21, 0.75) 100%);
			pointer-events: none;
		}

		.slider-controls-bar {
			position: absolute;
			bottom: 16px;
			left: 16px;
			right: 16px;
			display: flex;
			align-items: center;
			justify-content: space-between;
			pointer-events: auto;
		}

		.slider-dots {
			display: flex;
			gap: 6px;
			background: rgba(17, 18, 21, 0.6);
			backdrop-filter: blur(8px);
			padding: 6px 10px;
			border-radius: 999px;
			border: 1px solid rgba(255, 255, 255, 0.1);
		}

		.slider-dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: rgba(255, 255, 255, 0.35);
			border: none;
			padding: 0;
			cursor: pointer;
			transition: all 0.25s ease;
		}

		.slider-dot.active {
			background: var(--sand);
			width: 22px;
			border-radius: 4px;
		}

		.slider-buttons {
			display: flex;
			gap: 6px;
		}

		.slider-btn {
			width: 36px;
			height: 36px;
			border-radius: 50%;
			border: 1px solid rgba(255, 255, 255, 0.15);
			background: rgba(17, 18, 21, 0.72);
			backdrop-filter: blur(8px);
			color: var(--ivory);
			display: inline-flex;
			align-items: center;
			justify-content: center;
			font-size: 1rem;
			cursor: pointer;
			transition: all 0.2s ease;
		}

		.slider-btn:hover {
			border-color: var(--sand);
			color: var(--sand);
			transform: scale(1.08);
		}

		/* CHAPTER 05 (FINAL CTA BLOCK) */
		.chapter-cta-block {
			height: 100vh;
			height: 100svh;
			min-height: 100vh;
			min-height: 100svh;
			display: flex;
			align-items: center;
			justify-content: center;
			text-align: center;
			padding: calc(var(--topbar-height) + 16px) 0 32px;
			position: relative;
			scroll-snap-align: start;
			scroll-snap-stop: always;
			box-sizing: border-box;
		}

		.cta-box {
			max-width: 760px;
			margin: 0 auto;
			padding: clamp(28px, 4.5vw, 48px);
			border-radius: 36px;
			background:
				radial-gradient(ellipse at 50% 0%, rgba(216, 194, 138, 0.22), transparent 70%),
				linear-gradient(180deg, rgba(32, 34, 40, 0.8) 0%, rgba(17, 18, 21, 0.95) 100%);
			border: 1px solid var(--line-gold);
			box-shadow: 0 40px 100px rgba(0, 0, 0, 0.65);
			position: relative;
			overflow: hidden;
		}

		.cta-box::before {
			content: "";
			position: absolute;
			top: 0;
			left: 20%;
			right: 20%;
			height: 1px;
			background: linear-gradient(90deg, transparent, var(--sand), transparent);
		}

		.cta-title {
			font-family: var(--font-display);
			font-size: clamp(2.4rem, 4.6vw, 4rem);
			font-weight: 700;
			line-height: 1.1;
			margin: 0 0 20px;
			color: var(--ivory);
		}

		.cta-title em {
			font-style: italic;
			color: var(--sand);
		}

		.cta-lead {
			font-size: clamp(1.1rem, 1.8vw, 1.35rem);
			line-height: 1.65;
			color: var(--muted-ivory);
			margin: 0 0 36px;
		}

		.cta-actions {
			display: flex;
			justify-content: center;
			gap: 16px;
			flex-wrap: wrap;
			margin-bottom: 30px;
		}

		.cta-proof-strip {
			display: flex;
			justify-content: center;
			gap: clamp(18px, 4vw, 36px);
			padding-top: 24px;
			border-top: 1px solid var(--line-graphite);
			flex-wrap: wrap;
		}

		.cta-proof-item {
			font-size: 0.82rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: var(--muted-ivory);
			display: flex;
			align-items: center;
			gap: 8px;
		}

		.cta-proof-item span {
			color: var(--sand);
		}

		/* ========================================================
		   HOW TO JOIN SECTION
		   ======================================================== */
		.section-how {
			height: 100vh;
			height: 100svh;
			min-height: 100vh;
			min-height: 100svh;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: calc(var(--topbar-height) + 16px) 0 32px;
			border-top: 1px solid var(--line-graphite);
			background: rgba(17, 18, 21, 0.4);
			scroll-snap-align: start;
			scroll-snap-stop: always;
			box-sizing: border-box;
		}

		.section-head {
			text-align: center;
			max-width: 680px;
			margin: 0 auto clamp(40px, 6vw, 60px);
		}

		.section-tag {
			font-size: 0.76rem;
			font-weight: 700;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: var(--sand);
			display: inline-block;
			margin-bottom: 12px;
		}

		.section-title {
			font-family: var(--font-display);
			font-size: clamp(2rem, 3.5vw, 3rem);
			font-weight: 600;
			line-height: 1.15;
			margin: 0 0 16px;
			color: var(--ivory);
		}

		.section-desc {
			font-size: 1.05rem;
			color: var(--muted-ivory);
			margin: 0;
		}

		.steps-grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 20px;
		}

		.step-card {
			background: var(--graphite-card);
			border: 1px solid var(--line-graphite);
			border-radius: 24px;
			padding: 32px 28px;
			display: flex;
			flex-direction: column;
			gap: 14px;
			transition: all 0.3s ease;
			position: relative;
		}

		.step-card:hover {
			border-color: var(--line-gold);
			transform: translateY(-4px);
			box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
		}

		.step-number {
			font-family: var(--font-display);
			font-size: 2rem;
			font-weight: 700;
			color: var(--sand);
			line-height: 1;
		}

		.step-title {
			font-family: var(--font-display);
			font-size: 1.25rem;
			font-weight: 600;
			margin: 0;
			color: var(--ivory);
		}

		.step-text {
			font-size: 0.94rem;
			line-height: 1.6;
			color: var(--muted-ivory);
			margin: 0;
		}

		/* ========================================================
		   FAQ SECTION
		   ======================================================== */
		.section-faq {
			min-height: 100vh;
			min-height: 100svh;
			display: flex;
			align-items: center;
			justify-content: center;
			padding: calc(var(--topbar-height) + 16px) 0 32px;
			border-top: 1px solid var(--line-graphite);
			scroll-snap-align: start;
			scroll-snap-stop: always;
			box-sizing: border-box;
		}

		.faq-list {
			max-width: 780px;
			margin: 0 auto;
			display: grid;
			gap: 12px;
		}

		.faq-item {
			background: var(--graphite-card);
			border: 1px solid var(--line-graphite);
			border-radius: 18px;
			padding: 20px 24px;
			transition: border-color 0.25s ease;
		}

		.faq-item[open] {
			border-color: var(--line-gold);
		}

		.faq-summary {
			cursor: pointer;
			font-weight: 600;
			font-size: 1.05rem;
			color: var(--ivory);
			display: flex;
			align-items: center;
			justify-content: space-between;
			list-style: none;
			user-select: none;
		}

		.faq-summary::-webkit-details-marker {
			display: none;
		}

		.faq-summary::after {
			content: "+";
			font-size: 1.4rem;
			color: var(--sand);
			line-height: 1;
			transition: transform 0.25s ease;
		}

		.faq-item[open] .faq-summary::after {
			content: "−";
			transform: rotate(180deg);
		}

		.faq-content {
			margin-top: 14px;
			font-size: 0.96rem;
			line-height: 1.65;
			color: var(--muted-ivory);
		}

		/* ========================================================
		   FOOTER
		   ======================================================== */
		footer {
			border-top: 1px solid var(--line-graphite);
			background: rgba(24, 25, 29, 0.75);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			padding: 48px 0 60px;
			position: relative;
			z-index: 2;
			scroll-snap-align: end;
			scroll-snap-stop: normal;
		}

		.footer-inner {
			display: flex;
			justify-content: space-between;
			align-items: center;
			flex-wrap: wrap;
			gap: 24px;
		}

		.footer-brand-col {
			display: flex;
			flex-direction: column;
			gap: 8px;
		}

		.footer-tagline {
			font-size: 0.88rem;
			color: var(--muted-ivory);
		}

		.footer-socials {
			display: flex;
			gap: 10px;
		}

		.footer-copy {
			width: 100%;
			margin-top: 24px;
			padding-top: 24px;
			border-top: 1px solid rgba(255, 255, 255, 0.05);
			display: flex;
			justify-content: space-between;
			align-items: center;
			font-size: 0.82rem;
			color: rgba(244, 240, 232, 0.4);
			flex-wrap: wrap;
			gap: 12px;
		}

		/* ========================================================
		   REVEAL & SCROLL ANIMATIONS
		   ======================================================== */
		.reveal {
			opacity: 0;
			transform: translateY(32px);
			transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1), transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
		}

		.reveal.in-view {
			opacity: 1;
			transform: translateY(0);
		}

		/* Text and pictures fade in while rising; both replay when re-entering view */
		@media (prefers-reduced-motion: no-preference) {
			.spawn-text {
				opacity: 0;
				transform: translateY(36px);
				transition: opacity 400ms ease, transform 400ms ease;
			}

			.spawn-text.in-view {
				opacity: 1;
				transform: none;
				transition: opacity 1100ms cubic-bezier(0.16, 1, 0.3, 1), transform 1100ms cubic-bezier(0.16, 1, 0.3, 1);
				transition-delay: var(--spawn-delay, 0ms);
			}

			.spawn-media {
				opacity: 0;
				transform: translateY(36px);
				transition: opacity 400ms ease, transform 400ms ease;
			}

			.spawn-media.in-view {
				opacity: 1;
				transform: none;
				transition: opacity 800ms ease, transform 1100ms cubic-bezier(0.16, 1, 0.3, 1);
				transition-delay: var(--spawn-delay, 0ms);
			}

			.spawn-media .slider-slide img {
				scale: 1.2;
				transition: transform 0.6s ease, scale 400ms ease;
			}

			.spawn-media.in-view .slider-slide img {
				scale: 1;
				transition: transform 0.6s ease, scale 1800ms cubic-bezier(0.16, 1, 0.3, 1);
				transition-delay: 0ms, var(--spawn-delay, 0ms);
			}
		}


		/* Mobile menu drawer */
		.nav-toggle {
			display: none;
			width: 40px;
			height: 40px;
			border-radius: 50%;
			border: 1px solid var(--line-graphite);
			background: transparent;
			color: var(--ivory);
			align-items: center;
			justify-content: center;
			cursor: pointer;
		}

		.mobile-menu-drawer {
			display: none;
		}

		/* ========================================================
		   DESKTOP FLOATING SLIDE INDICATOR
		   ======================================================== */
		.slide-indicator {
			position: fixed;
			right: 24px;
			top: 50%;
			transform: translateY(-50%);
			z-index: 95;
			display: flex;
			flex-direction: column;
			gap: 12px;
			padding: 10px 8px;
			background: rgba(24, 25, 29, 0.45);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			border: 1px solid rgba(244, 240, 232, 0.08);
			border-radius: 24px;
		}

		:global(.slide-dot) {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			border: none;
			background: rgba(244, 240, 232, 0.28);
			padding: 0;
			cursor: pointer;
			position: relative;
			transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			outline: none;
		}

		:global(.slide-dot:hover),
		:global(.slide-dot:focus-visible) {
			background: var(--sand);
			transform: scale(1.35);
		}

		:global(.slide-dot.active) {
			height: 22px;
			border-radius: 10px;
			background: var(--sand);
			box-shadow: 0 0 12px rgba(216, 194, 138, 0.65);
		}

		:global(.slide-dot-tooltip) {
			position: absolute;
			right: 22px;
			top: 50%;
			transform: translateY(-50%) translateX(6px);
			background: rgba(24, 25, 29, 0.92);
			border: 1px solid var(--line-gold);
			color: var(--ivory);
			font-size: 0.74rem;
			font-weight: 500;
			white-space: nowrap;
			padding: 4px 10px;
			border-radius: 8px;
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.2s ease, transform 0.2s ease;
		}

		:global(.slide-dot:hover .slide-dot-tooltip) {
			opacity: 1;
			transform: translateY(-50%) translateX(0);
		}

		/* ========================================================
		   RESPONSIVE DESIGN (Option 1: Mobile Editorial Flow)
		   ======================================================== */
		@media (max-width: 960px) {
			:root {
				--topbar-height: 56px;
			}

			html {
				scroll-snap-type: y mandatory;
			}

			.slide-indicator {
				display: none;
			}

			.chapter-block,
			.chapter-cta-block,
			.section-how,
			.section-faq {
				height: auto;
				min-height: 100vh;
				min-height: 100svh;
				padding: calc(var(--topbar-height) + 32px) 0 48px;
				scroll-snap-align: start;
				scroll-snap-stop: always;
			}

			/* Section-level reveal offset would shift snap positions while scrolling */
			.chapter-block.reveal,
			.chapter-cta-block.reveal {
				transform: none;
			}

			.nav-menu {
				display: none;
			}

			.nav-toggle {
				display: inline-flex;
			}

			.chapter-layout > * {
				min-width: 0;
			}

			.slide-constellation-slot,
			.cta-constellation-slot {
				max-width: 100%;
			}

			.slider-track,
			.slider-slide {
				min-width: 0;
				width: 100%;
			}

			.chapter-block {
				flex-direction: column;
				align-items: stretch;
			}

			.chapter-block > .container {
				flex: 1 0 auto;
				display: flex;
				flex-direction: column;
			}

			.chapter-layout,
			.chapter-layout.reverse {
				display: flex;
				flex-direction: column;
				flex: 1 0 auto;
				gap: 28px;
			}

			.chapter-layout > .chapter-text-col {
				display: flex;
				flex-direction: column;
				flex: 1 0 auto;
			}

			.chapter-text-col > .slide-constellation-slot {
				width: 100%;
				aspect-ratio: auto;
				flex: 1 1 0;
				min-height: 120px;
				margin-bottom: 28px;
			}

			.chapter-layout.reverse .chapter-text-col,
			.chapter-layout.reverse .chapter-media-col {
				order: initial;
			}

			.steps-grid {
